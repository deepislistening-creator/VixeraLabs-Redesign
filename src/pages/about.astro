---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Impact from '../components/Impact.astro';
import OurStory from '../components/OurStory.astro';
import WhyItMatters from '../components/WhyItMatters.astro';
import WorkedWith from '../components/WorkedWith.astro';
import SelectedWork from '../components/SelectedWork.astro';
import Principles from '../components/Principles.astro';
import Faq from '../components/Faq.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Footer from '../components/Footer.astro';
import aboutHero from '../assets/About.png';

const stats = [
	{ prefix: '', value: 2015, suffix: '', label: 'building software since', count: false },
	{ prefix: '', value: 100, suffix: 'M+', label: 'downloads on apps our team built' },
	{ prefix: '$', value: 40, suffix: 'M+', label: 'raised by companies we’ve built for' },
	{ prefix: '', value: 5, suffix: '', label: 'client companies acquired' },
	{ prefix: '', value: 44, suffix: '+', label: 'products and AI systems shipped' },
	{ prefix: '', value: 3, suffix: '', label: 'regions served: the US, the Middle East and Southeast Asia' },
];
---

<Layout title="About | VixeraLabs">
	<section class="about-hero">
		<Image
			src={aboutHero}
			alt=""
			widths={[960, 1440, 1677]}
			sizes="100vw"
			format="webp"
			loading="eager"
			fetchpriority="high"
			class="about-hero__img"
		/>
		<Header tone="light" />

		<div class="content">
			<h1 class="heading">About Vixera Labs</h1>
		</div>
	</section>

	<Impact stats={stats}>
		<strong>Vixera Labs is an AI automation agency founded in 2015 by Harsh [Surname] and [Brother’s name].</strong>
		We’ve spent eleven years building software that holds up at scale, long before AI made it easy. Today we build AI
		systems that run operations for healthcare, finance and public-sector teams.
	</Impact>

	<OurStory />

	<WhyItMatters />

	<WorkedWith />

	<SelectedWork />

	<Principles />

	<Faq />

	<CtaBanner />
	<Footer />
</Layout>

<style>
	.about-hero {
		position: relative;
		height: 600px;
		overflow: hidden;
		display: flex;
		/* Heading sits bottom-left, clear of the faces in the photo */
		align-items: flex-end;
		background: #0c2b15;
	}

	.about-hero__img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 40%;
	}

	/* Dark wash on the left for the white heading, brand-green tint fading in on the right */
	.about-hero::after {
		content: '';
		position: absolute;
		inset: 0;
		background:
			linear-gradient(90deg, rgba(12, 43, 21, 0.6) 0%, rgba(12, 43, 21, 0.25) 40%, rgba(12, 43, 21, 0) 65%),
			linear-gradient(90deg, rgba(150, 248, 120, 0) 55%, rgba(150, 248, 120, 0.35) 100%),
			linear-gradient(180deg, rgba(12, 43, 21, 0.35) 0%, rgba(12, 43, 21, 0) 30%),
			linear-gradient(0deg, rgba(12, 43, 21, 0.45) 0%, rgba(12, 43, 21, 0) 45%);
		pointer-events: none;
	}

	.content {
		position: relative;
		z-index: 1;
		/* Keep this box off the header's area, or it covers the nav and blocks hover/clicks */
		padding: 0 50px 80px;
	}

	.heading {
		margin: 0;
		font-family: 'Source Serif 4', Georgia, serif;
		font-size: max(62px, calc(62 * var(--u)));
		font-weight: 400;
		line-height: 1.05;
		letter-spacing: -0.01em;
		color: #ffffff;
		text-wrap: balance;
	}

	@media (max-width: 768px) {
		.about-hero {
			height: 520px;
		}

		.about-hero__img {
			object-position: 35% center;
		}

		.content {
			padding: 0 16px 56px;
		}

		.heading {
			font-size: clamp(36px, 9vw, 62px);
		}
	}
</style>
