---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import ArrowButton from '../../components/ArrowButton.astro';
import ServiceVisual from '../../components/ServiceVisual.astro';
import Faq from '../../components/Faq.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import Footer from '../../components/Footer.astro';
import { services, type Service } from '../../data/services';

export function getStaticPaths() {
	return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

interface Props {
	service: Service;
}

const { service } = Astro.props;
const others = services.filter((s) => s.slug !== service.slug);
---

<Layout title={`${service.name} | VixeraLabs`}>
	<section class="hero" style={`--gradient:${service.visual.gradient}`}>
		<Header tone="light" />

		<div class="content">
			<a class="back" href="/services">← All services</a>
			<p class="eyebrow">{service.name}</p>
			<h1 class="heading">{service.headline}</h1>
			<p class="lead">{service.short}</p>
		</div>
	</section>

	<section class="overview">
		<ServiceVisual service={service} class="overview__visual" />

		<div class="overview__content">
			<p class="label">What it does</p>
			<p class="overview__text">{service.description}</p>

			<ul class="features">
				{
					service.features.map((feature) => (
						<li>
							<svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
								<path d="M3 8.5 6.5 12 13 4.5" />
							</svg>
							{feature}
						</li>
					))
				}
			</ul>

			<ArrowButton href="#contact" label="Get a Free Audit" class="overview__btn" />
		</div>
	</section>

	<section class="others" aria-labelledby="others-title">
		<p class="label" id="others-title">Other systems</p>
		<ul class="others__list">
			{
				others.map((other) => (
					<li>
						<a class="other" href={`/services/${other.slug}`}>
							<span class="other__name">{other.name}</span>
							<span class="other__short">{other.short}</span>
							<span class="other__arrow" aria-hidden="true">→</span>
						</a>
					</li>
				))
			}
		</ul>
	</section>

	<Faq />
	<CtaBanner />
	<Footer />
</Layout>

<style>
	.hero {
		position: relative;
		height: 640px;
		overflow: hidden;
		display: flex;
		align-items: flex-end;
		background: var(--gradient);
		font-family: 'Inter', system-ui, sans-serif;
	}

	.hero::before {
		content: '';
		position: absolute;
		width: 60vw;
		aspect-ratio: 1;
		right: -15vw;
		top: -30vw;
		border-radius: 50%;
		background: radial-gradient(circle, rgba(150, 248, 120, 0.35) 0%, rgba(150, 248, 120, 0) 70%);
		pointer-events: none;
	}

	.content {
		position: relative;
		z-index: 1;
		padding: 0 50px 80px;
		color: #ffffff;
	}

	.back {
		display: inline-block;
		margin-bottom: 28px;
		font-size: 14px;
		color: rgba(255, 255, 255, 0.75);
		text-decoration: none;
	}

	.back:hover {
		color: #ffffff;
	}

	.eyebrow {
		margin: 0 0 16px;
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: #96f878;
	}

	.heading {
		margin: 0;
		max-width: 16ch;
		font-family: 'Source Serif 4', Georgia, serif;
		font-size: max(62px, calc(62 * var(--u)));
		font-weight: 400;
		line-height: 1.05;
		letter-spacing: -0.01em;
		text-wrap: balance;
	}

	.lead {
		margin: 20px 0 0;
		font-size: 18px;
		font-weight: 300;
		color: rgba(255, 255, 255, 0.75);
	}

	/* ---------- overview ---------- */

	.overview {
		--pad: max(60px, calc(60 * var(--u)));
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: max(56px, calc(72 * var(--u)));
		align-items: center;
		padding: max(100px, calc(100 * var(--u))) var(--pad);
		font-family: 'Inter', system-ui, sans-serif;
	}

	.overview :global(.overview__visual) {
		--radius: 24px;
		min-height: 520px;
	}

	.label {
		margin: 0;
		font-family: 'Inter', system-ui, sans-serif;
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: #0c2b15;
	}

	.overview__text {
		margin: 16px 0 0;
		font-size: max(26px, calc(26 * var(--u)));
		font-weight: 300;
		line-height: 1.35;
		letter-spacing: -0.01em;
		color: #111111;
	}

	.features {
		display: grid;
		gap: 14px;
		margin: 32px 0 0;
		padding: 0;
		list-style: none;
		font-size: 16px;
		color: #212427;
	}

	.features li {
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.features svg {
		flex: none;
		width: 20px;
		height: 20px;
		padding: 2px;
		border-radius: 50%;
		background: #96f878;
		stroke: #0c2b15;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.overview__content :global(.overview__btn) {
		margin-top: 36px;
	}

	/* ---------- other services ---------- */

	.others {
		padding: 0 max(60px, calc(60 * var(--u))) max(100px, calc(100 * var(--u)));
		font-family: 'Inter', system-ui, sans-serif;
	}

	.others__list {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 16px;
		margin: 20px 0 0;
		padding: 0;
		list-style: none;
	}

	.other {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 8px;
		height: 100%;
		padding: 28px 56px 28px 28px;
		border: 1px solid #e4ebe1;
		border-radius: 20px;
		background: #f4f8f2;
		color: #111111;
		text-decoration: none;
		transition: background-color 0.25s ease;
	}

	.other:hover {
		background: #e3fddb;
	}

	.other__name {
		font-size: 24px;
		letter-spacing: -0.01em;
	}

	.other__short {
		font-size: 15px;
		font-weight: 300;
		color: #5e5e5e;
	}

	.other__arrow {
		position: absolute;
		top: 28px;
		right: 28px;
		font-size: 20px;
		transition: transform 0.25s ease;
	}

	.other:hover .other__arrow {
		transform: translateX(4px);
	}

	@media (max-width: 960px) {
		.overview {
			grid-template-columns: 1fr;
		}

		.overview :global(.overview__visual) {
			min-height: 420px;
		}

		.others__list {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 768px) {
		.hero {
			height: 560px;
		}

		.content {
			padding: 0 16px 56px;
		}

		.heading {
			font-size: clamp(36px, 9vw, 62px);
		}

		.overview,
		.others {
			padding-left: 16px;
			padding-right: 16px;
		}

		.overview {
			padding-top: 64px;
			padding-bottom: 64px;
		}

		.overview__text {
			font-size: 21px;
		}

		.overview :global(.overview__visual) {
			min-height: 340px;
		}
	}
</style>
