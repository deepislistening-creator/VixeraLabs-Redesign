---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import Footer from '../../components/Footer.astro';
import AutomationAgencyArticle from '../../components/AutomationAgencyArticle.astro';
import blogHero from '../../assets/Blog.png';
import { articles, type Article } from '../../data/articles';

export function getStaticPaths() {
	return articles.map((article) => ({ params: { slug: article.slug }, props: { article } }));
}

interface Props {
	article: Article;
}

const { article } = Astro.props;
const { author } = article;
const isAutomationGuide = article.slug === 'how-to-choose-an-ai-automation-agency';
const canonical = new URL(`/insights/${article.slug}`, 'https://vixeralabs-redesign.vercel.app').href;
const formattedDate = article.published && new Intl.DateTimeFormat('en', {
	dateStyle: 'medium',
	timeZone: 'UTC',
}).format(new Date(article.published));
const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: article.title,
	description: article.description,
	datePublished: article.published,
	dateModified: article.published,
	mainEntityOfPage: canonical,
	author: author && {
		'@type': 'Person',
		name: author.name,
		url: author.linkedin,
		image: new URL(author.headshot, canonical).href,
	},
	publisher: { '@type': 'Organization', name: 'Vixera Labs', url: new URL('/', canonical).href },
};
---

<Layout title={`${article.title} | VixeraLabs`}>
	{isAutomationGuide && (
		<Fragment slot="head">
			<meta name="description" content={article.description} />
			<link rel="canonical" href={canonical} />
			<meta property="og:type" content="article" />
			<meta property="og:title" content={article.title} />
			<meta property="og:description" content={article.description} />
			<meta property="og:url" content={canonical} />
			<script type="application/ld+json" set:html={JSON.stringify(structuredData).replaceAll('<', '\\u003c')} />
		</Fragment>
	)}
	<section class="post-hero">
		<Image
			src={article.image ?? blogHero}
			alt=""
			widths={[960, 1440, 1672]}
			sizes="100vw"
			format="webp"
			loading="eager"
			fetchpriority="high"
			class="post-hero__img"
		/>
		<Header tone="light" />

		<a class="back" href="/insights">
			<svg viewBox="0 0 18 16" fill="none" aria-hidden="true">
				<path
					d="M17 8H1.5M8 1.5 1.5 8 8 14.5"
					stroke="currentColor"
					stroke-width="1.6"
					stroke-linecap="round"
					stroke-linejoin="round"
				/>
			</svg>
			All articles
		</a>

		<div class="content">
			<p class="meta">
				<span class="meta__category">{article.category}</span>
				<span aria-hidden="true">·</span>
				{article.readTime}
			</p>
			<h1 class="heading">{article.title}</h1>
		</div>
	</section>

	<article class:list={['post', { 'post--with-rail': isAutomationGuide }]}>
		{author && (
			<div class="post-byline">
				<img src={author.headshot} alt="" width="56" height="56" />
				<span>By <a href={author.linkedin}>{author.name}</a></span>
			</div>
		)}
		{formattedDate && <p class="post-date">Published <time datetime={article.published}>{formattedDate}</time></p>}
		<p class="lead">{article.excerpt}</p>
		{isAutomationGuide && <AutomationAgencyArticle />}
	</article>

	{!isAutomationGuide && <CtaBanner />}
	<Footer />
</Layout>

<style>
	/* ---------- hero: same treatment as the Insights page ---------- */

	.post-hero {
		position: relative;
		height: 600px;
		overflow: hidden;
		display: flex;
		align-items: flex-end;
		background: #0c2b15;
	}

	.post-hero__img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: right center;
	}

	.post-hero::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(0deg, rgba(0, 20, 12, 0.55) 0%, rgba(0, 20, 12, 0) 55%);
		pointer-events: none;
	}

	.content {
		position: relative;
		z-index: 1;
		/* Keep this box off the header's area, or it covers the nav and blocks hover/clicks */
		max-width: 1100px;
		padding: 0 50px 80px;
	}

	.meta {
		display: flex;
		align-items: center;
		gap: 10px;
		margin: 0 0 20px;
		font-family: 'Inter', system-ui, sans-serif;
		font-size: 14px;
		font-weight: 400;
		color: rgba(255, 255, 255, 0.7);
	}

	.meta__category {
		font-size: 13px;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: #96f878;
	}

	.heading {
		margin: 0;
		font-family: 'Source Serif 4', Georgia, serif;
		font-size: max(56px, calc(56 * var(--u)));
		font-weight: 400;
		line-height: 1.08;
		letter-spacing: -0.01em;
		color: #ffffff;
		text-wrap: balance;
	}

	/* ---------- body ---------- */

	.post {
		max-width: 760px;
		margin: 0 auto;
		padding: max(80px, calc(80 * var(--u))) 24px max(100px, calc(100 * var(--u)));
		font-family: 'Inter', system-ui, sans-serif;
		color: #212427;
	}

	/* Top-left of the hero, just under the logo; above the ::after wash */
	.back {
		position: absolute;
		top: 150px;
		left: 50px;
		z-index: 1;
		display: inline-flex;
		align-items: center;
		gap: 10px;
		font-family: 'Inter', system-ui, sans-serif;
		font-size: 15px;
		font-weight: 500;
		color: rgba(255, 255, 255, 0.85);
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.back:hover {
		color: #ffffff;
	}

	.back svg {
		width: 16px;
		transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.back:hover svg,
	.back:focus-visible svg {
		transform: translateX(-4px);
	}

	.back:focus-visible {
		outline: 2px solid #ffffff;
		outline-offset: 3px;
		border-radius: 4px;
	}

	.post-byline {
		display: flex;
		align-items: center;
		gap: 12px;
		margin-bottom: 12px;
		color: #0c2b15;
	}

	.post-byline img {
		border-radius: 50%;
		object-fit: cover;
		object-position: 55% 30%;
	}

	.post-byline a {
		color: inherit;
		font-weight: 600;
		text-underline-offset: 3px;
	}

	.post-date { margin: 0 0 12px; color: #5e5e5e; font-size: 14px; }

	.lead {
		margin: 0;
		font-size: 22px;
		font-weight: 300;
		line-height: 1.55;
		color: #5e5e5e;
	}

	@media (min-width: 1024px) and (min-height: 620px) {
		.post--with-rail { max-width: 1088px; }

		.post--with-rail > :is(.post-byline, .post-date, .lead) {
			margin-left: 280px;
		}
	}

	@media (max-width: 768px) {
		.post-hero {
			height: 520px;
		}

		.content {
			padding: 0 16px 56px;
		}

		.back {
			top: 120px;
			left: 16px;
		}

		.heading {
			font-size: clamp(34px, 8.5vw, 56px);
		}

		.post {
			padding: 56px 16px 72px;
		}

		.lead {
			font-size: 18px;
		}
	}
</style>
