---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Impact from '../components/Impact.astro';
import Articles from '../components/Articles.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Footer from '../components/Footer.astro';
import blogHero from '../assets/Blog.png';
---

<Layout title="Insights | VixeraLabs">
	<section class="insights-hero">
		<Image
			src={blogHero}
			alt=""
			widths={[960, 1440, 1672]}
			sizes="100vw"
			format="webp"
			loading="eager"
			fetchpriority="high"
			class="insights-hero__img"
		/>
		<Header tone="light" />

		<div class="content">
			<h1 class="heading">Guides for founders<br /><span>who build</span></h1>
		</div>
	</section>

	<Impact showStats={false}>
		<strong>Straight answers for founders who ship, not founders who plan.</strong> Breakdowns, frameworks and hard-won
		lessons from every product we've built: what things really cost, how long they really take, and what we'd do
		differently next time.
	</Impact>

	<Articles />

	<CtaBanner />
	<Footer />
</Layout>

<style>
	.insights-hero {
		position: relative;
		height: 600px;
		overflow: hidden;
		display: flex;
		align-items: flex-end;
		background: #0c2b15;
	}

	.insights-hero__img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		/* Keep the bright lines on the right, the dark area behind the heading */
		object-position: right center;
	}

	/* The artwork is already dark on the left, so only a light wash at the bottom for the heading */
	.insights-hero::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(0deg, rgba(0, 20, 12, 0.45) 0%, rgba(0, 20, 12, 0) 45%);
		pointer-events: none;
	}

	.content {
		position: relative;
		z-index: 1;
		/* Keep this box off the header's area, or it covers the nav and blocks hover/clicks */
		padding: 0 50px 80px;
	}

	.heading {
		margin: 0;
		font-family: 'Source Serif 4', Georgia, serif;
		font-size: max(80px, calc(80 * var(--u)));
		font-weight: 400;
		line-height: 1.05;
		letter-spacing: -0.01em;
		color: #ffffff;
		text-wrap: balance;
	}

	/* Muted second line; on the dark hero a soft white stands in for the grey */
	.heading span {
		color: rgba(255, 255, 255, 0.7);
	}

	@media (max-width: 768px) {
		.insights-hero {
			height: 520px;
		}

		.content {
			padding: 0 16px 56px;
		}

		.heading {
			font-size: clamp(44px, 12vw, 80px);
		}
	}
</style>
