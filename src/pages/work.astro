---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Impact from '../components/Impact.astro';
import FeaturedWork from '../components/FeaturedWork.astro';
import Companies, { type Company } from '../components/Companies.astro';
import StartupWork from '../components/StartupWork.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Footer from '../components/Footer.astro';
import workHero from '../assets/workNewBg.png';
import redrank from '../assets/RedRankGrowth.png';
import freeShipFast from '../assets/FreeShipFastThumbnail.png';

const products: Company[] = [
	{
		name: 'RedRank',
		stat: { value: '24/7', label: 'Reddit lead discovery', tag: 'Product · AI · SaaS' },
		image: redrank,
		alt: 'A marketer presenting a rising growth chart and sales funnel to her team in a meeting room',
		info: {
			title: 'RedRank',
			text: 'Find high-intent Reddit leads for your SaaS on autopilot. We built it, we use it, we sell it.',
			cta: 'Coming soon',
		},
	},
	{
		name: 'Free Ship Fast',
		stat: { value: 'Hours', label: 'Idea to production', tag: 'Product · AI · No-code' },
		image: freeShipFast,
		alt: 'Two developers watching a successful deployment pipeline on a large monitor',
		info: {
			title: 'Free Ship Fast',
			text: 'Build and deploy custom AI chatbots with zero code.',
			href: '#',
			cta: 'Visit FreeShipFast',
		},
	},
];
---

<Layout title="Work | VixeraLabs">
	<section class="work-hero">
		<Image
			src={workHero}
			alt=""
			widths={[960, 1440, 2048]}
			sizes="100vw"
			format="webp"
			loading="eager"
			fetchpriority="high"
			class="work-hero__img"
		/>
		<Header tone="light" />

		<div class="content">
			<h1 class="heading">Products that solve real problems.<br /><span>Built to scale.</span></h1>
			<p class="subtitle">
				We partner with startups and enterprises to design, build, and launch digital products that drive impact.
			</p>
		</div>
	</section>

	<Impact />

	<FeaturedWork />

	<Companies
		id="products"
		title="Products we built ourselves."
		subtitle="We build, run and sell our own products, so we know what it takes to ship one."
		items={products}
		background="#ffffff"
	/>

	<StartupWork />

	<CtaBanner />
	<Footer />
</Layout>

<style>
	.work-hero {
		position: relative;
		height: 600px;
		overflow: hidden;
		display: flex;
		align-items: flex-end;
		background: #0c2b15;
	}

	.work-hero__img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		/* Keep the people at the table in frame when the sides are cropped */
		object-position: 60% center;
	}

	/* Darker wash at the bottom-left, where the heading sits over the bright table and windows */
	.work-hero::after {
		content: '';
		position: absolute;
		inset: 0;
		background:
			linear-gradient(0deg, rgba(0, 20, 12, 0.7) 0%, rgba(0, 20, 12, 0) 60%),
			linear-gradient(90deg, rgba(0, 20, 12, 0.45) 0%, rgba(0, 20, 12, 0) 55%);
		pointer-events: none;
	}

	.content {
		position: relative;
		z-index: 1;
		/* Keep this box off the header's area, or it covers the nav and blocks hover/clicks */
		padding: 0 50px 80px;
	}

	.heading {
		margin: 0;
		font-family: 'Source Serif 4', Georgia, serif;
		font-size: max(62px, calc(62 * var(--u)));
		font-weight: 400;
		line-height: 1.05;
		letter-spacing: -0.01em;
		color: #ffffff;
		text-wrap: balance;
	}

	/* Muted second line, same as the Insights hero */
	.heading span {
		color: rgba(255, 255, 255, 0.7);
	}

	.subtitle {
		max-width: 620px;
		margin: 24px 0 0;
		font-family: 'Inter', system-ui, sans-serif;
		font-size: 17px;
		font-weight: 300;
		line-height: 1.7;
		color: rgba(255, 255, 255, 0.7);
	}

	@media (max-width: 768px) {
		.work-hero {
			height: 560px;
		}

		.content {
			padding: 0 16px 56px;
		}

		.heading {
			font-size: clamp(36px, 9vw, 62px);
		}

		.subtitle {
			font-size: 16px;
		}
	}
</style>
