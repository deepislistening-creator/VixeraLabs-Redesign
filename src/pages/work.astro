---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Work | VixeraLabs">
	<Header />

	<section class="work-hero">
		<p class="eyebrow">Our Work</p>
		<h1 class="heading">Products founders run their business on.</h1>
		<p class="subtitle">MVPs, AI agents and full product builds - shipped on a fixed scope and a fixed timeline.</p>
	</section>

	<!-- Project content goes here -->

	<CtaBanner />
	<Footer />
</Layout>

<style>
	.work-hero {
		--pad: max(60px, calc(60 * var(--u)));
		/* Top padding clears the fixed header (40px offset + 70px tall) */
		padding: max(200px, calc(200 * var(--u))) var(--pad) max(100px, calc(100 * var(--u)));
		background: #ffffff;
		font-family: 'Inter', system-ui, sans-serif;
		color: #111111;
	}

	/* Same label as the FAQ and testimonial sections */
	.eyebrow {
		margin: 0;
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: #0c2b15;
	}

	.heading {
		max-width: 900px;
		margin: 16px 0 0;
		font-family: 'Source Serif 4', Georgia, serif;
		font-size: max(64px, calc(72 * var(--u)));
		font-weight: 400;
		line-height: 1.05;
		letter-spacing: -0.01em;
		text-wrap: balance;
	}

	.subtitle {
		max-width: 560px;
		margin: 20px 0 0;
		font-size: 17px;
		font-weight: 300;
		line-height: 1.5;
		color: #5e5e5e;
	}

	@media (max-width: 768px) {
		.work-hero {
			--pad: 16px;
			padding-top: 140px;
			padding-bottom: 72px;
		}

		.heading {
			font-size: clamp(40px, 11vw, 64px);
		}

		.subtitle {
			font-size: 16px;
		}
	}
</style>
