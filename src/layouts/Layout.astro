---
import 'lenis/dist/lenis.css';
import '@fontsource/inter/300.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/lora/500.css';
import '@fontsource/lora/400-italic.css';
import '@fontsource/source-serif-4/400.css';
import '@fontsource/ibm-plex-sans/300.css';
import '@fontsource/ibm-plex-sans/400.css';

interface Props {
	title?: string;
}

const { title = 'VixeraLabs' } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="data:," />
		<meta name="viewport" content="width=device-width" />
		<title>{title}</title>
		<slot name="head" />
	</head>
	<body>
		<slot />

		<script>
			import Lenis from 'lenis';

			// Skip smooth scrolling for visitors who ask for reduced motion
			const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

			if (!prefersReducedMotion) {
				const lenis = new Lenis({
					duration: 1.2,
					easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
					anchors: true,
					autoRaf: true,
				});

				// Expose for GSAP ScrollTrigger and other scripts later
				window.lenisInstance = lenis;
			}
		</script>
	</body>
</html>

<style is:global>
	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	:root {
		/* One design pixel at 1440px wide; sizes use max(Npx, calc(N * var(--u))) to scale up on wider screens */
		--u: calc(100vw / 1440);
	}

	html,
	body {
		margin: 0;
		padding: 0;
	}

	body {
		background: #ffffff;
	}
</style>
