---
interface Project {
	category: string;
	title?: string;
	text: string;
	rating?: string;
	featured?: boolean;
}

// Images are still to come; each row shows a blank media area until then
const projects: Project[] = [
	{
		category: 'Mobile game development',
		title: 'My Puppy Daycare Salon',
		text: 'A playful care experience reaching 10M+ downloads.',
		rating: '4.1',
		featured: true,
	},
	{
		category: 'AI operations platform',
		text: 'From manual work to intelligent automation.',
	},
	{
		category: 'Digital product experience',
		text: 'Modern web experiences for high-growth teams.',
	},
];
---

<section class="work" aria-labelledby="work-title">
	<div class="head">
		<p class="eyebrow">Selected work</p>
		<h2 class="title" id="work-title">Where expert development meets next-generation AI.</h2>
		<p class="subtitle">
			From consumer apps reaching millions to AI systems transforming how teams work,<br />
			we build products designed for real-world adoption.
		</p>
	</div>

	<ol class="panels">
		{
			projects.map((item, i) => (
				<li class:list={['panel', { 'panel--featured': item.featured }]} tabindex="0">
					<div class="panel__media" aria-hidden="true" />

					<span class="panel__index">{String(i + 1).padStart(2, '0')}</span>

					<div class="panel__body">
						<p class="panel__category">{item.category}</p>

						<div class="panel__details">
							{/* Projects without a name use their one-liner as the headline */}
							<h3 class="panel__title">{item.title ?? item.text}</h3>
							{item.title && <p class="panel__text">{item.text}</p>}

							{item.rating && (
								<span class="panel__rating">
									{item.rating}
									<span aria-hidden="true">★</span> Rating
								</span>
							)}
						</div>
					</div>
				</li>
			))
		}
	</ol>

	<a class="more" href="/work">
		Explore all work
		<svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
			<path d="M2 8h11M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
		</svg>
	</a>
</section>

<style>
	.work {
		--pad: max(60px, calc(60 * var(--u)));
		background: #f1eeea;
		padding: max(100px, calc(100 * var(--u))) var(--pad);
		font-family: 'Inter', system-ui, sans-serif;
		color: #0c2b15;
	}

	/* ---------- heading: same treatment as the Principles section ---------- */

	.eyebrow {
		margin: 0;
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: #0c2b15;
	}

	.title {
		margin: 12px 0 0;
		font-size: max(44px, calc(44 * var(--u)));
		font-weight: 400;
		line-height: 1.15;
		letter-spacing: -0.02em;
		color: #111111;
	}

	.subtitle {
		margin: 12px 0 0;
		font-size: 16px;
		font-weight: 300;
		line-height: 1.4;
		color: #5e5e5e;
	}

	/* ---------- expanding panels: the open panel grows, the others shrink to slim columns ---------- */

	.panels {
		display: flex;
		gap: 12px;
		height: max(560px, calc(560 * var(--u)));
		margin: max(48px, calc(48 * var(--u))) 0 0;
		padding: 0;
		list-style: none;
	}

	.panel {
		position: relative;
		flex: 1;
		min-width: 0;
		overflow: hidden;
		border-radius: 18px;
		background: #0c2b15;
		color: #ffffff;
		cursor: pointer;
		outline: none;
		transition: flex 0.6s cubic-bezier(0.22, 1, 0.36, 1);
	}

	/* The featured panel is open by default; hovering or focusing another one opens it instead */
	.panel--featured,
	.panels:hover .panel:hover,
	.panels:focus-within .panel:focus {
		flex: 3.2;
	}

	.panels:hover .panel:not(:hover),
	.panels:focus-within .panel:not(:focus) {
		flex: 1;
	}

	.panel:focus-visible {
		box-shadow: 0 0 0 3px #f1eeea, 0 0 0 5px #2f6b25;
	}

	/* Placeholder art until the project images are added; a dark fade keeps the text legible */
	.panel__media {
		position: absolute;
		inset: 0;
		background:
			radial-gradient(120% 80% at 80% 10%, rgba(120, 190, 90, 0.35), transparent 60%),
			linear-gradient(160deg, #1d4a26 0%, #0c2b15 70%);
		transition: transform 0.8s ease;
	}

	.panel:nth-child(2) .panel__media {
		background:
			radial-gradient(120% 80% at 20% 0%, rgba(200, 220, 160, 0.28), transparent 60%),
			linear-gradient(160deg, #2a3d2c 0%, #111c14 70%);
	}

	.panel:nth-child(3) .panel__media {
		background:
			radial-gradient(120% 80% at 70% 100%, rgba(140, 200, 120, 0.3), transparent 60%),
			linear-gradient(200deg, #163a20 0%, #0a1f10 70%);
	}

	.panel__media::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, transparent 35%, rgba(6, 18, 9, 0.75) 100%);
	}

	.panel:hover .panel__media {
		transform: scale(1.04);
	}

	.panel__index {
		position: absolute;
		top: 26px;
		left: 28px;
		font-family: 'Source Serif 4', Georgia, serif;
		font-size: 18px;
		color: rgba(255, 255, 255, 0.7);
	}

	.panel__body {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		padding: 28px;
	}

	.panel__category {
		margin: 0;
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.85);
	}

	/* Details only show on the open panel; fixed width so text doesn't reflow while it grows */
	.panel__details {
		width: max(440px, calc(440 * var(--u)));
		max-width: 100%;
		max-height: 0;
		overflow: hidden;
		opacity: 0;
		transform: translateY(12px);
		transition:
			opacity 0.3s ease,
			transform 0.4s ease,
			max-height 0.4s ease;
	}

	.panel--featured .panel__details,
	.panels:hover .panel:hover .panel__details,
	.panels:focus-within .panel:focus .panel__details {
		max-height: 320px;
		opacity: 1;
		transform: none;
		transition-delay: 0.15s;
	}

	.panels:hover .panel:not(:hover) .panel__details,
	.panels:focus-within .panel:not(:focus) .panel__details {
		max-height: 0;
		opacity: 0;
		transform: translateY(12px);
		transition-delay: 0s;
	}

	.panel__title {
		margin: 14px 0 0;
		font-family: 'Source Serif 4', Georgia, serif;
		font-size: max(38px, calc(38 * var(--u)));
		font-weight: 400;
		line-height: 1.12;
		letter-spacing: -0.01em;
		color: #ffffff;
	}

	.panel__text {
		margin: 12px 0 0;
		font-size: 16px;
		line-height: 1.55;
		color: rgba(255, 255, 255, 0.75);
	}

	.panel__rating {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		margin-top: 20px;
		padding: 8px 16px;
		border-radius: 8px;
		background: #e3fddb;
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: #0c2b15;
	}

	.more {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		margin-top: 32px;
		padding-bottom: 2px;
		border-bottom: 1px solid currentColor;
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		text-decoration: none;
		color: #0c2b15;
	}

	.more svg {
		transition: transform 0.2s ease;
	}

	.more:hover svg {
		transform: translateX(3px);
	}

	/* ---------- responsive ---------- */

	/* No hover on touch screens: stack the panels and show every panel's details */
	@media (max-width: 900px) {
		.panels {
			flex-direction: column;
			height: auto;
		}

		/* !important beats the hover/focus rules above, which a tap would otherwise trigger */
		.panel {
			flex: none !important;
			min-height: 340px;
		}

		.panel__details {
			width: auto;
			max-height: none !important;
			opacity: 1 !important;
			transform: none !important;
		}
	}

	@media (max-width: 640px) {
		.work {
			--pad: 16px;
			padding-top: 72px;
			padding-bottom: 72px;
		}

		.title {
			font-size: clamp(34px, 9vw, 44px);
		}

		.subtitle br {
			display: none;
		}

		.panel {
			min-height: 300px;
		}

		.panel__title {
			font-size: 28px;
		}
	}
</style>
