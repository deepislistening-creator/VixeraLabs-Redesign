---
interface Feature {
	tag: string;
	title: string;
	link: { label: string; href: string };
}

const features: Feature[] = [
	{
		tag: 'Healthcare · AI automation',
		title: 'Automating a $1B-revenue healthcare system.',
		link: { label: 'Read the healthcare case study', href: '/work' },
	},
	{
		tag: 'Finance · SME lending',
		title: 'Automating $1B+ in SME credit across Southeast Asia.',
		link: { label: 'Read the SME lending case study', href: '/work' },
	},
	{
		tag: 'Agency · Operations',
		title: '12-hour days to 10 minutes for a $5M agency.',
		link: { label: 'Read the Mckayn case study', href: '/work' },
	},
];

const INTERVAL_MS = 5500;
---

<aside class="featured" aria-label="Client results" style={`--interval:${INTERVAL_MS}ms`}>
	<div class="deck">
		{
			features.map((feature, i) => (
				<article
					class:list={['slide', { 'is-active': i === 0 }]}
					style={`--pos:${i}`}
					inert={i !== 0}
				>
					<div class="slide__inner">
					<div class="featured__head">
						<span class="featured__eyebrow">
							<span class="featured__dot" />
							Client results
						</span>
						<div class="featured__pips">
							{features.map((f, p) => (
								<button
									class:list={['featured__pip', { 'is-active': p === i }]}
									type="button"
									data-index={p}
									aria-label={`Show ${f.link.label}`}
									aria-current={p === i ? 'true' : 'false'}
								>
									<span class="featured__fill" />
								</button>
							))}
						</div>
					</div>

					<p class="slide__tag">{feature.tag}</p>
					<p class="slide__title">{feature.title}</p>
					<a class="slide__link" href={feature.link.href}>
						{feature.link.label}
						<span class="slide__arrow" aria-hidden="true">→</span>
					</a>
					</div>
				</article>
			))
		}
	</div>
</aside>

<style>
	.featured {
		--ink: #0c2b15;
		--green: #96f878;
		--ease: cubic-bezier(0.22, 1, 0.36, 1);
		position: absolute;
		right: 50px;
		bottom: 50px;
		z-index: 1;
		width: 440px;
		font-family: 'Inter', system-ui, sans-serif;
		color: #212427;
	}

	/* ---------- header ---------- */

	.featured__head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 16px;
	}

	.featured__eyebrow {
		display: flex;
		align-items: center;
		gap: 10px;
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--ink);
	}

	.featured__dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: #3ddc6b;
		box-shadow: 0 0 0 0 rgba(61, 220, 107, 0.6);
		animation: featured-pulse 2s ease-out infinite;
	}

	.featured__pips {
		display: flex;
		gap: 6px;
	}

	.featured__pip {
		position: relative;
		width: 22px;
		height: 4px;
		padding: 0;
		border: 0;
		border-radius: 4px;
		background: rgba(12, 43, 21, 0.15);
		overflow: hidden;
		cursor: pointer;
	}

	/* Enlarge the click target without changing the look */
	.featured__pip::after {
		content: '';
		position: absolute;
		inset: -8px -3px;
	}

	.featured__pip:focus-visible {
		outline: 2px solid var(--ink);
		outline-offset: 3px;
	}

	.featured__fill {
		position: absolute;
		inset: 0;
		background: var(--ink);
		transform: scaleX(0);
		transform-origin: left;
	}

	/* The active pip's fill doubles as the rotation timer: when it finishes, the next feature shows */
	.slide.is-active .featured__pip.is-active .featured__fill {
		animation: featured-fill var(--interval) linear forwards;
	}

	.featured:hover .featured__fill,
	.featured:focus-within .featured__fill {
		animation-play-state: paused;
	}

	/* ---------- card deck ---------- */

	/*
	 * Every feature is its own glass card, stacked in one grid cell. --pos is the card's place in
	 * the stack (0 = front); cards further back sit higher, smaller and fainter so their top edges
	 * peek out. On change the front card plays deck-to-back (drops, slips behind, rises to the back)
	 * while the next card eases forward.
	 */
	.deck {
		display: grid;
		isolation: isolate;
	}

	.slide {
		grid-area: 1 / 1;
		padding: 20px;
		border: 1px solid rgba(255, 255, 255, 0.7);
		border-radius: 20px;
		background: rgba(255, 255, 255, 0.6);
		-webkit-backdrop-filter: blur(43px);
		backdrop-filter: blur(43px);
		box-shadow: 0 10px 40px rgba(12, 43, 21, 0.08);
		transform-origin: 50% 0;
		z-index: calc(10 - var(--pos));
		transform: translateY(calc(var(--pos) * -14px)) scale(calc(1 - var(--pos) * 0.05));
		opacity: calc(1 - var(--pos) * 0.25);
		transition:
			transform 0.8s var(--ease),
			opacity 0.8s ease;
	}

	.slide.is-active {
		transition-delay: 0.22s;
	}

	.slide.is-leaving {
		animation: deck-to-back 0.95s cubic-bezier(0.65, 0, 0.35, 1);
	}

	/* Cards behind the front one show only their glass edge */
	.slide__inner {
		opacity: 0;
		transition: opacity 0.3s ease;
	}

	.slide.is-active .slide__inner {
		opacity: 1;
		transition: opacity 0.4s ease 0.3s;
	}

	.slide__tag,
	.slide__title,
	.slide__link {
		opacity: 0;
		transform: translateY(12px);
		transition:
			opacity 0.35s ease,
			transform 0.35s ease;
	}

	.is-active .slide__tag,
	.is-active .slide__title,
	.is-active .slide__link {
		opacity: 1;
		transform: none;
		transition:
			opacity 0.6s ease,
			transform 0.7s var(--ease);
	}

	.is-active .slide__tag {
		transition-delay: 0.4s;
	}

	.is-active .slide__title {
		transition-delay: 0.49s;
	}

	.is-active .slide__link {
		transition-delay: 0.58s;
	}

	/* ---------- text + link ---------- */

	.slide__tag {
		margin: 0;
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.06em;
		color: #3f8a34;
	}

	.slide__title {
		margin: 6px 0 0;
		font-family: 'Source Serif 4', Georgia, serif;
		font-size: 26px;
		font-weight: 400;
		line-height: 1.2;
		letter-spacing: -0.01em;
		color: var(--ink);
		text-wrap: balance;
	}

	.slide__link {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		margin-top: 20px;
		font-size: 15px;
		font-weight: 600;
		color: var(--ink);
		text-decoration: none;
	}

	.slide__arrow {
		transition: transform 0.35s var(--ease);
	}

	.slide__link:hover .slide__arrow,
	.slide__link:focus-visible .slide__arrow {
		transform: translateX(4px);
	}

	.slide__link:focus-visible {
		outline: 2px solid var(--ink);
		outline-offset: 3px;
		border-radius: 4px;
	}

	/* ---------- keyframes ---------- */

	/* No 100% keyframe: the card finishes wherever its new --pos puts it */
	@keyframes deck-to-back {
		0% {
			z-index: 20;
			transform: translateY(0) scale(1);
			opacity: 1;
		}
		45% {
			z-index: 20;
			transform: translateY(42px) scale(0.97);
			opacity: 0.85;
		}
		46% {
			z-index: 0;
		}
	}

	@keyframes featured-fill {
		to {
			transform: scaleX(1);
		}
	}

	@keyframes featured-pulse {
		0% {
			box-shadow: 0 0 0 0 rgba(61, 220, 107, 0.6);
		}
		70%,
		100% {
			box-shadow: 0 0 0 7px rgba(61, 220, 107, 0);
		}
	}

	/* ---------- responsive + motion ---------- */

	@media (max-width: 1500px) {
		.featured {
			width: 400px;
		}

		.slide__title {
			font-size: 24px;
		}
	}

	/* Below this the card would collide with the headline */
	@media (max-width: 1340px) {
		.featured {
			display: none;
		}
	}

	/* No auto-rotation or decorative motion; features can still be switched with the pips */
	@media (prefers-reduced-motion: reduce) {
		.featured__pip.is-active .featured__fill {
			animation: none;
			transform: scaleX(1);
		}

		.featured__dot,
		.slide.is-leaving {
			animation: none;
		}

		.slide,
		.slide__inner {
			transition: none !important;
		}

		.slide__tag,
		.slide__title,
		.slide__link {
			transition: none !important;
		}
	}
</style>

<script>
	document.querySelectorAll<HTMLElement>('.featured').forEach((card) => {
		const slides = [...card.querySelectorAll<HTMLElement>('.slide')];
		const count = slides.length;
		let index = 0;

		function show(next: number) {
			if (next === index) return;
			const leaving = slides[index];
			index = next;

			// Send the old front card behind the stack, then restack everything around the new front
			leaving.classList.remove('is-leaving');
			void leaving.offsetWidth; // restart the animation if it is still running
			leaving.classList.add('is-leaving');

			slides.forEach((slide, i) => {
				const pos = (i - index + count) % count;
				slide.style.setProperty('--pos', String(pos));
				slide.classList.toggle('is-active', pos === 0);
				slide.inert = pos !== 0;
			});
		}

		card.querySelectorAll<HTMLButtonElement>('.featured__pip').forEach((pip) => {
			pip.addEventListener('click', () => show(Number(pip.dataset.index)));
		});

		card.addEventListener('animationend', (event) => {
			const target = event.target as HTMLElement;
			// The front card's active pip fill is the timer
			if (target.classList.contains('featured__fill')) show((index + 1) % count);
			if (target.classList.contains('is-leaving')) target.classList.remove('is-leaving');
		});
	});
</script>
