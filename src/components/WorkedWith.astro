---
interface Featured {
	tag: string;
	name: string;
}

interface Client {
	name: string;
	// Second line under the name; shown in the placeholder colour until filled in
	note?: string;
}

const featured: Featured[] = [
	{ tag: 'Under NDA · Lending', name: 'Southeast Asia’s largest credit guarantee corporation' },
];

const clients: Client[] = [
	{ name: 'eClinicalWorks' },
	{ name: 'Office of Chicago Alderman', note: '[Name]' },
	{ name: 'mckayn' },
	{ name: 'Janitri' },
	{ name: 'PulzCAD' },
	{ name: 'Dealroom Media' },
];
---

<section class="clients" aria-labelledby="clients-title">
	<div class="head">
		<p class="eyebrow">Clients</p>
		<h2 class="title" id="clients-title">Who we’ve worked with</h2>
		<p class="intro">
			Healthcare software companies, a public-sector office, two of the largest credit institutions in Asia and the
			Middle East, and founders backed by Shark Tank and VCs.
		</p>
	</div>

	<ul class="grid">
		{
			featured.map((item) => (
				<li class="featured__card">
					<p class="featured__tag">{item.tag}</p>
					<h3 class="featured__name">{item.name}</h3>
				</li>
			))
		}

		{
			clients.map((client) => (
				<li class="tile">
					<span class="tile__name">{client.name}</span>
					{client.note && <span class="tile__note">{client.note}</span>}
				</li>
			))
		}
	</ul>

	<a class="link" href="/work">See client results →</a>
</section>

<style>
	.clients {
		--pad: max(60px, calc(60 * var(--u)));
		--ink: #0c2b15;
		--body: #3b4a40;
		--card: #f1f1ef;
		background: #ffffff;
		padding: max(100px, calc(100 * var(--u))) var(--pad);
		font-family: 'Inter', system-ui, sans-serif;
		color: var(--ink);
	}

	/* ---------- heading: same treatment as Our story and Why it matters ---------- */

	.eyebrow {
		margin: 0;
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: #2f6b25;
	}

	.title {
		margin: 12px 0 0;
		font-family: 'Source Serif 4', Georgia, serif;
		font-size: max(44px, calc(44 * var(--u)));
		font-weight: 400;
		line-height: 1.15;
		letter-spacing: -0.01em;
		color: var(--ink);
	}

	.intro {
		max-width: max(800px, calc(800 * var(--u)));
		margin: 20px 0 0;
		font-size: max(17px, calc(17 * var(--u)));
		font-weight: 400;
		line-height: 1.65;
		color: var(--body);
	}

	/* ---------- bento grid: featured (NDA) card on the left, client tiles on the right ---------- */

	.grid {
		display: grid;
		grid-template-columns: 1.6fr repeat(3, 1fr);
		grid-auto-rows: minmax(max(150px, calc(150 * var(--u))), auto);
		gap: 12px;
		margin: max(40px, calc(40 * var(--u))) 0 0;
		padding: 0;
		list-style: none;
	}

	.featured__card {
		grid-row: span 2;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 40px;
		padding: max(34px, calc(34 * var(--u))) max(32px, calc(32 * var(--u)));
		border-radius: 16px;
		background: var(--ink);
		color: #ffffff;
	}

	.featured__tag {
		align-self: flex-start;
		margin: 0;
		padding: 6px 12px;
		border: 1px solid rgba(255, 255, 255, 0.25);
		border-radius: 999px;
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.8);
	}

	.featured__name {
		max-width: 16ch;
		margin: 0;
		font-family: 'Source Serif 4', Georgia, serif;
		font-size: max(34px, calc(34 * var(--u)));
		font-weight: 400;
		line-height: 1.15;
		letter-spacing: -0.01em;
		color: #ffffff;
	}

	/* ---------- client name tiles ---------- */

	.tile {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		justify-content: flex-end;
		gap: 4px;
		padding: 22px 24px;
		border-radius: 16px;
		background: var(--card);
		transition: background-color 0.2s ease;
	}

	.tile:hover {
		background: #e8ede6;
	}

	.tile__name {
		font-size: max(19px, calc(19 * var(--u)));
		font-weight: 500;
		line-height: 1.25;
		letter-spacing: -0.01em;
		color: var(--ink);
	}

	.tile__note {
		font-size: max(14px, calc(14 * var(--u)));
		font-weight: 500;
		color: #b4436c;
	}

	/* ---------- link ---------- */

	.link {
		display: inline-block;
		margin-top: max(28px, calc(28 * var(--u)));
		padding-bottom: 2px;
		border-bottom: 1px solid currentColor;
		font-size: 15px;
		font-weight: 600;
		color: #111111;
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.link:hover {
		color: #2f6b25;
	}

	/* ---------- responsive ---------- */

	/* Tablet: featured card becomes a full-width banner above the tiles */
	@media (max-width: 1100px) {
		.grid {
			grid-template-columns: repeat(3, 1fr);
			grid-auto-rows: minmax(120px, auto);
		}

		.featured__card {
			grid-column: 1 / -1;
			grid-row: auto;
		}
	}

	@media (max-width: 640px) {
		.clients {
			--pad: 16px;
			padding-top: 72px;
			padding-bottom: 72px;
		}

		.title {
			font-size: clamp(34px, 9vw, 44px);
		}

		.intro {
			font-size: 16px;
		}

		.featured__card {
			padding: 26px 22px;
		}

		.featured__name {
			font-size: 28px;
		}

		.grid {
			grid-template-columns: repeat(2, 1fr);
			grid-auto-rows: minmax(100px, auto);
		}

		.tile {
			padding: 18px;
		}

		.tile__name {
			font-size: 16px;
		}
	}
</style>
