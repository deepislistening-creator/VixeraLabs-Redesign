---
interface Featured {
	tag: string;
	name: string;
}

interface Client {
	name: string;
	// Second line under the name; shown in the placeholder colour until filled in
	note?: string;
}

const featured: Featured[] = [
	{ tag: 'Under NDA · Finance', name: 'Saudi Arabia’s largest credit provider' },
	{ tag: 'Under NDA · Lending', name: 'Southeast Asia’s largest credit guarantee corporation' },
];

const clients: Client[] = [
	{ name: 'eClinicalWorks' },
	{ name: 'Office of Chicago Alderman', note: '[Name]' },
	{ name: 'mckayn' },
	{ name: 'Janitri' },
	{ name: 'PulzCAD' },
	{ name: 'Dealroom Media' },
];
---

<section class="clients" aria-labelledby="clients-title">
	<div class="head">
		<p class="eyebrow">Clients</p>
		<h2 class="title" id="clients-title">Who we’ve worked with</h2>
		<p class="intro">
			Healthcare software companies, a public-sector office, two of the largest credit institutions in Asia and the
			Middle East, and founders backed by Shark Tank and VCs.
		</p>
	</div>

	<ul class="featured">
		{
			featured.map((item) => (
				<li class="featured__card">
					<p class="featured__tag">{item.tag}</p>
					<h3 class="featured__name">{item.name}</h3>
				</li>
			))
		}
	</ul>

	<ul class="tiles">
		{
			clients.map((client) => (
				<li class="tile">
					<span class="tile__name">{client.name}</span>
					{client.note && <span class="tile__note">{client.note}</span>}
				</li>
			))
		}
	</ul>

	<a class="link" href="/work">See client results →</a>
</section>

<style>
	.clients {
		--pad: max(60px, calc(60 * var(--u)));
		--ink: #0c2b15;
		--body: #3b4a40;
		--card: #f1f1ef;
		background: #ffffff;
		padding: max(100px, calc(100 * var(--u))) var(--pad);
		font-family: 'Inter', system-ui, sans-serif;
		color: var(--ink);
	}

	/* ---------- heading: same treatment as Our story and Why it matters ---------- */

	.eyebrow {
		margin: 0;
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: #2f6b25;
	}

	.title {
		margin: 12px 0 0;
		font-family: 'Source Serif 4', Georgia, serif;
		font-size: max(44px, calc(44 * var(--u)));
		font-weight: 400;
		line-height: 1.15;
		letter-spacing: -0.01em;
		color: var(--ink);
	}

	.intro {
		max-width: max(800px, calc(800 * var(--u)));
		margin: 20px 0 0;
		font-size: max(17px, calc(17 * var(--u)));
		font-weight: 400;
		line-height: 1.65;
		color: var(--body);
	}

	/* ---------- featured (NDA) clients ---------- */

	.featured {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 16px;
		margin: max(40px, calc(40 * var(--u))) 0 0;
		padding: 0;
		list-style: none;
	}

	.featured__card {
		padding: max(34px, calc(34 * var(--u))) max(30px, calc(30 * var(--u)));
		border-top: 2px solid #1a1a1a;
		background: var(--card);
	}

	.featured__tag {
		margin: 0;
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: #1a1a1a;
	}

	.featured__name {
		max-width: 22ch;
		margin: 16px 0 0;
		font-size: max(32px, calc(32 * var(--u)));
		font-weight: 300;
		line-height: 1.2;
		letter-spacing: -0.01em;
		color: #111111;
	}

	/* ---------- client name tiles ---------- */

	.tiles {
		display: grid;
		grid-template-columns: repeat(6, 1fr);
		gap: 12px;
		margin: 16px 0 0;
		padding: 0;
		list-style: none;
	}

	.tile {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 4px;
		min-height: max(84px, calc(84 * var(--u)));
		padding: 12px 16px;
		background: var(--card);
		text-align: center;
	}

	.tile__name {
		font-size: max(15px, calc(15 * var(--u)));
		font-weight: 500;
		line-height: 1.3;
		color: #5e5e5e;
	}

	.tile__note {
		font-size: max(14px, calc(14 * var(--u)));
		font-weight: 500;
		color: #b4436c;
	}

	/* ---------- link ---------- */

	.link {
		display: inline-block;
		margin-top: max(28px, calc(28 * var(--u)));
		padding-bottom: 2px;
		border-bottom: 1px solid currentColor;
		font-size: 15px;
		font-weight: 600;
		color: #111111;
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.link:hover {
		color: #2f6b25;
	}

	/* ---------- responsive ---------- */

	@media (max-width: 1100px) {
		.tiles {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	@media (max-width: 900px) {
		.featured {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 640px) {
		.clients {
			--pad: 16px;
			padding-top: 72px;
			padding-bottom: 72px;
		}

		.title {
			font-size: clamp(34px, 9vw, 44px);
		}

		.intro {
			font-size: 16px;
		}

		.featured__card {
			padding: 26px 22px;
		}

		.featured__name {
			font-size: 24px;
		}

		.tiles {
			grid-template-columns: repeat(2, 1fr);
		}
	}
</style>
