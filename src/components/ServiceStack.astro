---
import ArrowButton from './ArrowButton.astro';
import ServiceVisual from './ServiceVisual.astro';
import { services } from '../data/services';
---

<section class="stack" aria-labelledby="stack-title">
	<div class="head">
		<p class="eyebrow">What we build</p>
		<h2 class="title" id="stack-title">Four systems. One goal: less busywork.</h2>
		<p class="subtitle">Pick a ready-made operating system, or have us build one around you.</p>
	</div>

	<ol class="cards">
		{
			services.map((service, i) => (
				<li class="card" style={`--i:${i}`}>
					<article class="card__inner">
						<ServiceVisual service={service} class="card__visual" />

						<div class="card__content">
							<p class="card__tag">
								{String(i + 1).padStart(2, '0')} / {String(services.length).padStart(2, '0')}
							</p>
							<h3 class="card__name">{service.name}</h3>
							<p class="card__headline">{service.headline}</p>
							<p class="card__text">{service.description}</p>

							<ul class="card__features">
								{service.features.map((feature) => (
									<li>
										<svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
											<path d="M3 8.5 6.5 12 13 4.5" />
										</svg>
										{feature}
									</li>
								))}
							</ul>

							<ArrowButton href={`/services/${service.slug}`} label={`Explore ${service.name}`} class="card__btn" />
						</div>
					</article>
				</li>
			))
		}
	</ol>
</section>

<style>
	.stack {
		--pad: max(60px, calc(60 * var(--u)));
		/* Cards stick just under the fixed header, each one a little lower than the last */
		--stick-top: 130px;
		--stick-step: 24px;
		background: #ffffff;
		padding: max(100px, calc(100 * var(--u))) var(--pad);
		font-family: 'Inter', system-ui, sans-serif;
		color: #0c2b15;
	}

	/* ---------- heading: same treatment as Principles / FAQ ---------- */

	.eyebrow {
		margin: 0;
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.title {
		margin: 12px 0 0;
		font-size: max(44px, calc(44 * var(--u)));
		font-weight: 400;
		line-height: 1.15;
		letter-spacing: -0.02em;
		color: #111111;
	}

	.subtitle {
		margin: 12px 0 0;
		font-size: 16px;
		font-weight: 300;
		line-height: 1.4;
		color: #5e5e5e;
	}

	/* ---------- stacking cards ---------- */

	.cards {
		display: grid;
		gap: 40px;
		margin: 56px 0 0;
		padding: 0;
		list-style: none;
	}

	.card {
		position: sticky;
		top: calc(var(--stick-top) + var(--i) * var(--stick-step));
	}

	.card__inner {
		display: grid;
		grid-template-columns: 1fr 1fr;
		height: min(620px, calc(100vh - var(--stick-top) - 4 * var(--stick-step) - 20px));
		min-height: 520px;
		overflow: hidden;
		border: 1px solid #e4ebe1;
		border-radius: 28px;
		background: #f4f8f2;
		box-shadow: 0 -10px 40px rgba(12, 43, 21, 0.06);
		/* Set by the script as the next card slides over this one */
		transform: scale(var(--scale, 1));
		transform-origin: 50% 0;
		will-change: transform;
	}

	/* Dims a card as it gets covered */
	.card__inner::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
		background: #0c2b15;
		opacity: var(--dim, 0);
		pointer-events: none;
	}

	.card__inner {
		position: relative;
	}

	.card__visual {
		--radius: 20px;
		margin: 12px 0 12px 12px;
	}

	.card__content {
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: 48px max(48px, calc(56 * var(--u)));
	}

	.card__tag {
		margin: 0;
		font-size: 13px;
		font-weight: 600;
		letter-spacing: 0.08em;
		color: #2f7a45;
	}

	.card__name {
		margin: 14px 0 0;
		font-size: max(48px, calc(48 * var(--u)));
		font-weight: 400;
		line-height: 1.05;
		letter-spacing: -0.02em;
		color: #111111;
	}

	.card__headline {
		margin: 10px 0 0;
		font-family: 'Source Serif 4', Georgia, serif;
		font-size: max(22px, calc(22 * var(--u)));
		line-height: 1.3;
		color: #2f7a45;
	}

	.card__text {
		margin: 18px 0 0;
		max-width: 52ch;
		font-size: 16px;
		font-weight: 300;
		line-height: 1.55;
		color: #313131;
	}

	.card__features {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 12px 24px;
		margin: 26px 0 0;
		padding: 0;
		list-style: none;
		font-size: 14px;
		line-height: 1.4;
		color: #212427;
	}

	.card__features li {
		display: flex;
		align-items: flex-start;
		gap: 10px;
	}

	.card__features svg {
		flex: none;
		width: 18px;
		height: 18px;
		padding: 2px;
		border-radius: 50%;
		background: #96f878;
		stroke: #0c2b15;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.card__content :global(.card__btn) {
		align-self: flex-start;
		margin-top: 32px;
	}

	/* ---------- responsive ---------- */

	@media (max-width: 1100px) {
		.card__inner {
			grid-template-columns: 1fr 1.2fr;
		}

		.card__content {
			padding: 36px;
		}

		.card__features {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 860px) {
		.stack {
			--stick-top: 100px;
			--stick-step: 12px;
		}

		.card__inner {
			grid-template-columns: 1fr;
			grid-template-rows: auto 1fr;
			height: auto;
			min-height: 0;
		}

		.card__visual {
			margin: 10px 10px 0;
			min-height: 300px;
		}

		.card__content {
			padding: 28px 24px 32px;
		}

		/* Keeps each card short enough to stay in view while stuck */
		.card__text {
			display: none;
		}
	}

	@media (max-width: 640px) {
		.stack {
			--pad: 16px;
			padding-top: 72px;
			padding-bottom: 72px;
		}

		.title {
			font-size: clamp(34px, 9vw, 44px);
		}

		.cards {
			gap: 24px;
			margin-top: 40px;
		}

		.card__visual {
			min-height: 260px;
		}

		.card__name {
			font-size: 36px;
		}

		.card__headline {
			font-size: 19px;
		}

		.card__features {
			margin-top: 18px;
			font-size: 13px;
		}

		.card__content :global(.card__btn) {
			align-self: stretch;
			margin-top: 24px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.card__inner {
			transform: none;
		}
	}
</style>

<script>
	// As each card slides over the one before it, the covered card shrinks and dims slightly
	const cards = [...document.querySelectorAll<HTMLElement>('.stack .card')];
	const inners = cards.map((card) => card.querySelector<HTMLElement>('.card__inner')!);
	const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	let ticking = false;

	function update() {
		ticking = false;

		for (let i = 0; i < cards.length - 1; i++) {
			const current = cards[i].getBoundingClientRect();
			const next = cards[i + 1].getBoundingClientRect();
			// 0 while the next card is a full card-height away, 1 once it has fully stacked on top
			const travel = Math.max(current.height, 1);
			const p = Math.min(Math.max(1 - (next.top - current.top) / travel, 0), 1);

			inners[i].style.setProperty('--scale', String(1 - p * 0.05));
			inners[i].style.setProperty('--dim', String(p * 0.25));
		}
	}

	function onScroll() {
		if (!ticking) {
			ticking = true;
			requestAnimationFrame(update);
		}
	}

	if (!reduced && cards.length) {
		update();
		window.addEventListener('scroll', onScroll, { passive: true });
		window.addEventListener('resize', onScroll);
	}
</script>
