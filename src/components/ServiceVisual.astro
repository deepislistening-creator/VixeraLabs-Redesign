---
import type { Service } from '../data/services';

interface Props {
	service: Service;
	class?: string;
}

const { service, class: className } = Astro.props;
const { visual } = service;
---

<div class:list={['visual', className]} style={`--gradient:${visual.gradient}`} aria-hidden="true">
	<div class="visual__glow"></div>

	<div class="visual__window">
		<div class="visual__bar">
			<span></span><span></span><span></span>
			<p class="visual__name">{service.name}</p>
		</div>

		<p class="visual__title">{visual.title}</p>

		<ul class="visual__rows">
			{
				visual.rows.map((row, i) => (
					<li class="visual__row" style={`--i:${i}`}>
						<span class="visual__dot" />
						<span class="visual__label">{row.label}</span>
						<span class="visual__status">{row.status}</span>
					</li>
				))
			}
		</ul>
	</div>

	<div class="visual__metric">
		<span class="visual__value">{visual.metric.value}</span>
		<span class="visual__metric-label">{visual.metric.label}</span>
	</div>
</div>

<style>
	/* A mock "automation feed" for each service: glass window over a green gradient */
	.visual {
		position: relative;
		overflow: hidden;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 40px;
		background: var(--gradient);
		font-family: 'Inter', system-ui, sans-serif;
		color: #ffffff;
		/* Backdrop root, so the glass blur stays inside the panel */
		border-radius: var(--radius, 0px);
		clip-path: inset(0 round var(--radius, 0px));
	}

	.visual__glow {
		position: absolute;
		width: 70%;
		aspect-ratio: 1;
		right: -20%;
		top: -25%;
		border-radius: 50%;
		background: radial-gradient(circle, rgba(150, 248, 120, 0.45) 0%, rgba(150, 248, 120, 0) 70%);
		pointer-events: none;
	}

	.visual__window {
		position: relative;
		width: min(100%, 420px);
		padding: 18px 20px 22px;
		border: 1px solid rgba(255, 255, 255, 0.18);
		border-radius: 18px;
		background: rgba(255, 255, 255, 0.1);
		-webkit-backdrop-filter: blur(18px);
		backdrop-filter: blur(18px);
		box-shadow: 0 30px 60px rgba(0, 0, 0, 0.25);
	}

	.visual__bar {
		display: flex;
		align-items: center;
		gap: 6px;
	}

	.visual__bar span {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.35);
	}

	.visual__name {
		margin: 0 0 0 auto;
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.7);
	}

	.visual__title {
		margin: 20px 0 14px;
		font-size: 20px;
		font-weight: 400;
		letter-spacing: -0.01em;
	}

	.visual__rows {
		display: grid;
		gap: 8px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.visual__row {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 12px 14px;
		border-radius: 12px;
		background: rgba(255, 255, 255, 0.08);
		font-size: 14px;
	}

	.visual__dot {
		flex: none;
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: #96f878;
		box-shadow: 0 0 0 4px rgba(150, 248, 120, 0.18);
	}

	.visual__label {
		flex: 1;
		min-width: 0;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.visual__status {
		flex: none;
		padding: 3px 10px;
		border-radius: 999px;
		background: rgba(150, 248, 120, 0.16);
		font-size: 12px;
		font-weight: 500;
		color: #c9fbb8;
	}

	.visual__metric {
		position: absolute;
		left: 28px;
		bottom: 28px;
		display: flex;
		flex-direction: column;
		padding: 14px 18px;
		border-radius: 14px;
		background: #96f878;
		color: #0c2b15;
		box-shadow: 0 16px 40px rgba(0, 0, 0, 0.2);
	}

	.visual__value {
		font-size: 28px;
		font-weight: 600;
		line-height: 1;
		letter-spacing: -0.02em;
	}

	.visual__metric-label {
		margin-top: 4px;
		font-size: 12px;
		font-weight: 500;
	}

	@media (max-width: 640px) {
		.visual {
			padding: 24px 20px 84px;
		}

		.visual__title {
			margin: 14px 0 10px;
			font-size: 17px;
		}

		.visual__row {
			padding: 9px 12px;
			font-size: 13px;
		}

		.visual__metric {
			left: 20px;
			bottom: 20px;
			padding: 10px 14px;
		}

		.visual__value {
			font-size: 22px;
		}
	}
</style>
