---
import { services } from '../data/services';

interface Props {
	// 'light' for pages whose header sits on a dark photo
	tone?: 'dark' | 'light';
}

const { tone = 'dark' } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

const links = [
	{ label: 'Home', href: '/' },
	{ label: 'About', href: '/about' },
	{ label: 'Services', href: '/services' },
	{ label: 'Work', href: '/work' },
	{ label: 'Insights', href: '/insights' },
];
---

<header class:list={['header', { 'header--light': tone === 'light' }]}>
	<a class="brand" href="/" aria-label="VIXERA LABS home">
		<img class="brand__logo" src="/assets/Logo.png" alt="" width="228" height="196" />
		<span class="brand__name">VIXERA LABS</span>
	</a>

	<div class="actions">
		<nav class="nav glass" aria-label="Main">
			{
				links.map((link) => {
					// Sub-pages (e.g. /insights/<post>) keep their section highlighted
					const current =
						link.href === pathname || (link.href !== '/' && pathname.startsWith(`${link.href}/`))
							? 'page'
							: undefined;

					if (link.href !== '/services') {
						return (
							<a class="nav__link" href={link.href} aria-current={current}>
								{link.label}
							</a>
						);
					}

					// Services opens a dropdown of the individual service pages on hover / keyboard focus
					return (
						<div class="nav__item">
							<a class="nav__link" href={link.href} aria-current={current} aria-haspopup="true">
								{link.label}
								<svg class="nav__chevron" viewBox="0 0 12 12" fill="none" aria-hidden="true">
									<path d="M3 4.5 6 7.5 9 4.5" />
								</svg>
							</a>
							<div class="menu">
								<ul class="menu__list">
									{services.map((service) => (
										<li>
											<a
												class="menu__link"
												href={`/services/${service.slug}`}
												aria-current={pathname === `/services/${service.slug}` ? 'page' : undefined}
											>
												<span class="menu__name">{service.name}</span>
												<span class="menu__short">{service.short}</span>
											</a>
										</li>
									))}
								</ul>
							</div>
						</div>
					);
				})
			}
		</nav>

		<a class="cta glass" href="#contact">Get a Free Audit</a>
	</div>
</header>

<style>
	.header {
		position: fixed;
		top: 40px;
		left: 50px;
		right: 50px;
		/* Above every section's own stacking (cards, panels use 1-2) */
		z-index: 100;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		font-family: 'Inter', system-ui, sans-serif;
		color: #212427;
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 12px;
		height: 70px;
		padding: 0;
		border-radius: 20px;
		color: #0f2a14;
		text-decoration: none;
		transition:
			padding 0.3s ease,
			background-color 0.3s ease,
			color 0.3s ease;
	}

	.header--light .brand {
		color: #ffffff;
	}

	/* Once scrolled, the brand floats over any section, so it gets the same glass as the nav */
	.header.is-scrolled .brand {
		padding: 0 20px;
		background: rgba(255, 255, 255, 0.6);
		-webkit-backdrop-filter: blur(43px);
		backdrop-filter: blur(43px);
		color: #0f2a14;
	}

	.brand__logo {
		display: block;
		width: auto;
		height: 36px;
	}

	.brand__name {
		font-size: 22px;
		font-weight: 700;
		letter-spacing: -0.04em;
		line-height: 1;
	}

	.actions {
		display: flex;
		align-items: center;
		gap: 12px;
	}

	/* White at 60% with background blur (Figma blur 86 ≈ CSS blur 43px) */
	.glass {
		height: 70px;
		border-radius: 20px;
		background: rgba(255, 255, 255, 0.6);
		-webkit-backdrop-filter: blur(43px);
		backdrop-filter: blur(43px);
	}

	.nav {
		width: 536px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0 13px;
	}

	.nav__link {
		display: flex;
		align-items: center;
		height: 44px;
		padding: 0 18px;
		border-radius: 14px;
		font-size: 15px;
		font-weight: 500;
		text-transform: uppercase;
		color: #212427;
		text-decoration: none;
		transition: background-color 0.25s ease;
	}

	/* ---------- Services dropdown ---------- */

	.nav__item {
		position: relative;
	}

	.nav__link {
		gap: 6px;
	}

	.nav__chevron {
		width: 12px;
		height: 12px;
		stroke: currentColor;
		stroke-width: 1.6;
		stroke-linecap: round;
		stroke-linejoin: round;
		transition: transform 0.25s ease;
	}

	.nav__item:hover .nav__chevron,
	.nav__item:focus-within .nav__chevron {
		transform: rotate(180deg);
	}

	/* The top padding bridges the gap below the nav, so the pointer can travel into the menu without it closing */
	.menu {
		position: absolute;
		top: 100%;
		left: 50%;
		padding-top: 22px;
		opacity: 0;
		visibility: hidden;
		transform: translate(-50%, 6px);
		transition:
			opacity 0.2s ease,
			transform 0.2s ease,
			visibility 0s linear 0.2s;
	}

	.nav__item:hover .menu,
	.nav__item:focus-within .menu {
		opacity: 1;
		visibility: visible;
		transform: translate(-50%, 0);
		transition:
			opacity 0.2s ease,
			transform 0.2s ease,
			visibility 0s;
	}

	/* Near-opaque instead of glass: a blur nested inside the nav's blur can't see the page behind it */
	.menu__list {
		width: 340px;
		margin: 0;
		padding: 8px;
		list-style: none;
		border-radius: 20px;
		background: rgba(255, 255, 255, 0.97);
		box-shadow: 0 20px 50px rgba(12, 43, 21, 0.16);
	}

	.menu__link {
		display: flex;
		flex-direction: column;
		gap: 3px;
		padding: 12px 16px;
		border-radius: 14px;
		color: #212427;
		text-decoration: none;
		transition: background-color 0.2s ease;
	}

	.menu__link:hover,
	.menu__link[aria-current='page'] {
		background: #e3fddb;
	}

	.menu__link:focus-visible {
		outline: 2px solid #212427;
		outline-offset: -2px;
	}

	.menu__name {
		font-size: 15px;
		font-weight: 600;
	}

	.menu__short {
		font-size: 13px;
		color: #5e5e5e;
	}

	.nav__link[aria-current='page'] {
		background: #e3fddb;
	}

	.nav__link:hover {
		background: #96f878;
	}

	.nav__link:focus-visible,
	.cta:focus-visible {
		outline: 2px solid #212427;
		outline-offset: 2px;
	}

	.cta {
		width: 213px;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 16px;
		font-weight: 600;
		color: #212427;
		text-decoration: none;
		transition: background-color 0.25s ease;
	}

	.cta:hover {
		background: rgba(255, 255, 255, 0.8);
	}

	/* The full row needs ~1100px; hide the links below that until a mobile menu exists */
	@media (max-width: 1100px) {
		.nav {
			display: none;
		}
	}

	@media (max-width: 640px) {
		.header {
			left: 16px;
			right: 16px;
			top: 24px;
		}

		.cta {
			display: none;
		}
	}
</style>

<script>
	const header = document.querySelector<HTMLElement>('.header');
	const updateScrolled = () => header?.classList.toggle('is-scrolled', window.scrollY > 10);
	updateScrolled();
	window.addEventListener('scroll', updateScrolled, { passive: true });

	const navLinks = document.querySelectorAll<HTMLAnchorElement>('.nav__link');

	function select(active: HTMLAnchorElement) {
		navLinks.forEach((link) => {
			if (link === active) link.setAttribute('aria-current', 'page');
			else link.removeAttribute('aria-current');
		});
	}

	navLinks.forEach((link) => link.addEventListener('click', () => select(link)));

	// Restore the selection when the page is opened at a section, e.g. /#work
	const fromHash = [...navLinks].find((link) => link.hash && link.hash === location.hash);
	if (fromHash) select(fromHash);
</script>
