---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ArrowButton from './ArrowButton.astro';
import eclinical from '../assets/eclinicalNew.png';
import bank from '../assets/bank.png';

export interface Company {
	name: string;
	stat: { value: string; label: string; tag: string };
	image?: ImageMetadata;
	alt?: string;
	// CSS object-position, to keep the subject in frame when the image is cropped
	focus?: string;
	// Slight zoom to trim artefacts at the image edges (e.g. 1.02)
	zoom?: number;
	// CSS background shown behind/instead of the image (stand-in until a photo is added)
	tint?: string;
	// cta defaults to "Read case study"; a cta without href renders as a static pill (e.g. "Coming soon")
	info?: { title: string; text: string; href?: string; cta?: string };
}

interface Props {
	id?: string;
	title?: string;
	subtitle?: string;
	items?: Company[];
	// Section background; defaults to the warm off-white
	background?: string;
}

// Remaining cards get their images and info content later
const defaultCompanies: Company[] = [
	{
		name: 'eClinical',
		stat: { value: '$1B+', label: 'Revenue', tag: 'AI Systems · Healthcare' },
		image: eclinical,
		alt: 'A pharmacy counter with a computer running dispensing software',
		focus: 'center',
		info: {
			title: 'Automating a billion-dollar healthcare CRM',
			text: 'We automated repetitive CRM operations so teams could move faster with less manual work.',
		},
	},
	{
		name: 'McKayn',
		stat: { value: '$1T+', label: 'Loan distribution', tag: 'AI Systems · Banking' },
		image: bank,
		alt: 'Bank sign on the facade of a glass office building',
		focus: 'center',
		info: {
			title: 'Faster credit decisions, powered by AI',
			text: 'We automated borrower checks and risk review while keeping final approvals with the bank.',
		},
	},
];

const {
	id = 'work',
	title = 'AI systems in action.',
	subtitle = 'Real systems. Measurable impact. Built inside businesses where speed, accuracy, and control matter.',
	items: companies = defaultCompanies,
	background,
} = Astro.props;

const titleId = `${id}-title`;
const arrowPath = 'M1 8h15.5M10 1.5 16.5 8 10 14.5';
---

<section
	class="companies"
	id={id}
	aria-labelledby={titleId}
	style={background ? `background:${background}` : undefined}
>
	<div class="head">
		<div>
			<h2 class="title" id={titleId}>{title}</h2>
			<p class="subtitle">{subtitle}</p>
		</div>

		<div class="controls">
			<button class="arrow" type="button" data-dir="-1" aria-label="Previous company" disabled>
				<svg viewBox="0 0 18 16" fill="none" aria-hidden="true" style="transform: scaleX(-1)">
					<path d={arrowPath} stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
				</svg>
			</button>
			<button class="arrow" type="button" data-dir="1" aria-label="Next company">
				<svg viewBox="0 0 18 16" fill="none" aria-hidden="true">
					<path d={arrowPath} stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
				</svg>
			</button>
		</div>
	</div>

	<ul class="track" aria-label={title.replace(/\.$/, '')}>
		{
			companies.map((company, i) => (
				<li
					class="card"
					aria-label={`${i + 1} of ${companies.length}: ${company.name}`}
					style={company.tint ? `background:${company.tint}` : undefined}
				>
					{!company.image && company.tint && (
						<span class="card__wordmark" aria-hidden="true">{company.name}</span>
					)}
					{company.image && (
						<Image
							src={company.image}
							alt={company.alt ?? ''}
							widths={[1000, 1400, 2000, 2600, 3200]}
							sizes="(max-width: 640px) 192vw, min(70vw, 1300px)"
							format="webp"
							loading={i < 2 ? 'eager' : 'lazy'}
							class="card__img"
							style={`object-position:${company.focus ?? 'center'}${company.zoom ? `;transform:scale(${company.zoom})` : ''}`}
						/>
					)}

					<div class="card__stat">
						<span class="card__stat-value">{company.stat.value}</span>
						<span class="card__stat-label">{company.stat.label}</span>
						<span class="card__stat-tag">{company.stat.tag}</span>
					</div>

					{company.info && (
						<div class="card__info">
							<h3 class="card__info-title">{company.info.title}</h3>
							<p class="card__info-text">{company.info.text}</p>
							<div class="card__info-cta">
								{company.info.cta && !company.info.href ? (
									<span class="card__info-soon">{company.info.cta}</span>
								) : (
									<ArrowButton href={company.info.href ?? '#'} label={company.info.cta ?? 'Read case study'} />
								)}
							</div>
						</div>
					)}
				</li>
			))
		}
	</ul>
</section>

<style>
	.companies {
		--pad: max(60px, calc(60 * var(--u)));
		background: #f1eeea;
		padding: max(100px, calc(100 * var(--u))) 0 max(100px, calc(100 * var(--u))) var(--pad);
		font-family: 'Inter', system-ui, sans-serif;
		color: #0c2b15;
		overflow: hidden;
	}

	/* ---------- heading + arrows ---------- */

	.head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 24px;
		padding-right: var(--pad);
	}

	.title {
		margin: 0;
		font-size: max(44px, calc(44 * var(--u)));
		font-weight: 400;
		line-height: 1.15;
		letter-spacing: -0.02em;
	}

	.subtitle {
		margin: 12px 0 0;
		font-size: 16px;
		font-weight: 300;
		color: #5e5e5e;
	}

	.controls {
		display: flex;
		gap: 12px;
		flex: none;
	}

	.arrow {
		display: grid;
		place-items: center;
		width: 58px;
		height: 58px;
		padding: 0;
		border: 1px solid #d6d6d6;
		border-radius: 50%;
		background: transparent;
		color: #111111;
		cursor: pointer;
		transition:
			background-color 0.2s ease,
			border-color 0.2s ease,
			color 0.2s ease;
	}

	.arrow svg {
		width: 20px;
	}

	.arrow:hover:not(:disabled) {
		border-color: #0c2b15;
		background: #ffffff;
	}

	.arrow:disabled {
		color: #a3a3a3;
		cursor: default;
	}

	.arrow:focus-visible {
		outline: 2px solid #0c2b15;
		outline-offset: 3px;
	}

	/* ---------- carousel track ---------- */

	/*
	 * Full-bleed track: cards line up with the page margins, while neighbouring cards peek in
	 * from the screen edges. The first card snaps to the left margin, the last to the right margin.
	 */
	.track {
		position: relative; /* makes card.offsetLeft relative to the track */
		display: flex;
		gap: 24px;
		margin: 40px 0 0 calc(-1 * var(--pad));
		padding: 0 var(--pad);
		scroll-padding-inline: var(--pad);
		list-style: none;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scroll-behavior: smooth;
		scrollbar-width: none;
		overscroll-behavior-x: contain;
	}

	.track::-webkit-scrollbar {
		display: none;
	}

	.card {
		position: relative;
		flex: 0 0 min(70vw, 1300px);
		aspect-ratio: 16 / 9;
		padding: 14px;
		overflow: hidden;
		background: #e2ddd6;
		scroll-snap-align: start;
	}

	.card:last-child {
		scroll-snap-align: end;
	}

	.card__img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* Stat panel, top-left */
	.card__stat {
		position: absolute;
		top: 14px;
		left: 14px;
		z-index: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 14px;
		min-width: 190px;
		padding: 26px 24px 24px;
		border-radius: 20px;
		background: rgba(255, 255, 255, 0.72);
		-webkit-backdrop-filter: blur(20px);
		backdrop-filter: blur(20px);
		text-align: center;
		color: #111111;
		/* Fades back in only once the info box has mostly shrunk back */
		transition: opacity 0.3s ease 0.35s;
	}

	.card__stat-value {
		font-family: 'IBM Plex Sans', system-ui, sans-serif;
		font-size: 44px;
		font-weight: 400;
		line-height: 1;
		letter-spacing: -0.02em;
	}

	.card__stat-label {
		max-width: 190px;
		font-size: 13px;
		font-weight: 400;
		line-height: 1.3;
		letter-spacing: 0.02em;
		text-transform: uppercase;
	}

	.card__stat-tag {
		margin-top: -4px;
		padding-top: 10px;
		border-top: 1px solid rgba(17, 17, 17, 0.12);
		font-size: 11px;
		font-weight: 500;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		white-space: nowrap;
		color: #5e5e5e;
	}

	.card__info {
		position: absolute;
		right: 20px;
		bottom: 20px;
		width: 500px;
		max-width: calc(100% - 40px);
		height: 268px;
		border-radius: 20px;
		background: rgba(255, 255, 255, 0.6);
		-webkit-backdrop-filter: blur(20px);
		backdrop-filter: blur(20px);
		display: flex;
		flex-direction: column;
		padding: 28px 28px 24px;
		color: #111111;
		z-index: 2;
		transition:
			width 0.6s cubic-bezier(0.65, 0, 0.35, 1),
			height 0.6s cubic-bezier(0.65, 0, 0.35, 1);
	}

	/* Expand to fill the whole card on hover (anchored bottom-right, so it grows up and left) */
	@media (hover: hover) and (min-width: 641px) {
		.card__info:hover,
		.card__info:focus-within {
			width: calc(100% - 40px);
			height: calc(100% - 40px);
		}

		/* Hide the stat panel so its corner doesn't peek out behind the expanded box */
		.card:has(.card__info:hover) .card__stat,
		.card:has(.card__info:focus-within) .card__stat {
			opacity: 0;
			transition-delay: 0s;
		}
	}

	/* Text keeps its resting width so it doesn't reflow while the panel animates */
	.card__info-title,
	.card__info-text {
		max-width: 444px;
	}

	.card__info-title {
		margin: 0;
		font-family: 'IBM Plex Sans', system-ui, sans-serif;
		font-size: 30px;
		font-weight: 400;
		line-height: 1.25;
		letter-spacing: -0.01em;
	}

	.card__info-text {
		margin: 14px 0 0;
		font-size: 15px;
		font-weight: 400;
		line-height: 1.55;
		color: #2b2b2b;
	}

	.card__info-cta {
		align-self: flex-end;
		margin-top: auto;
	}

	/* Same footprint as the arrow button, but inert: for products not live yet */
	.card__info-soon {
		height: 52px;
		min-width: 213px;
		padding: 0 24px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border: 1px solid rgba(12, 43, 21, 0.2);
		border-radius: 14px;
		font-size: 15px;
		font-weight: 600;
		text-transform: uppercase;
		color: rgba(12, 43, 21, 0.6);
	}

	/* Product name stand-in, centred on the tinted card until a screenshot is added */
	.card__wordmark {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		font-family: 'IBM Plex Sans', system-ui, sans-serif;
		font-size: max(72px, calc(72 * var(--u)));
		font-weight: 500;
		letter-spacing: -0.03em;
		color: rgba(255, 255, 255, 0.92);
		mix-blend-mode: overlay;
	}

	/* ---------- responsive + motion ---------- */

	@media (max-width: 640px) {
		.companies {
			--pad: 16px;
			padding-top: 72px;
			padding-bottom: 72px;
		}

		.head {
			flex-direction: column;
			align-items: flex-start;
		}

		.arrow {
			width: 48px;
			height: 48px;
		}

		.track {
			gap: 12px;
		}

		.card {
			flex-basis: 86vw;
			aspect-ratio: 4 / 5;
		}

		.card__stat {
			min-width: 120px;
			padding: 16px;
			gap: 8px;
		}

		.card__stat-value {
			font-size: 30px;
		}

		.card__stat-label {
			font-size: 11px;
		}

		.card__info {
			left: 14px;
			right: 14px;
			bottom: 14px;
			width: auto;
			max-width: none;
			height: auto;
			padding: 18px;
		}

		.card__info-title {
			font-size: 20px;
		}

		.card__info-text {
			margin-top: 8px;
			font-size: 13px;
		}

		.card__info-cta {
			margin-top: 14px;
		}

		.card__info-cta :global(.arrow-btn),
		.card__info-soon {
			height: 44px;
			min-width: 0;
			padding: 0 18px;
			font-size: 13px;
		}

		.card__wordmark {
			font-size: 40px;
			/* Sit in the gap between the stat panel and the info box */
			place-items: start center;
			padding-top: 45%;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.card__info,
		.card__stat {
			transition: none;
		}

		.track {
			scroll-behavior: auto;
		}
	}
</style>

<script>
	document.querySelectorAll<HTMLElement>('.companies').forEach((section) => {
		const track = section.querySelector<HTMLElement>('.track');
		const cards = section.querySelectorAll<HTMLElement>('.card');
		const [prev, next] = section.querySelectorAll<HTMLButtonElement>('.arrow');
		if (!track || !cards.length || !prev || !next) return;

		// Scroll position for each card: aligned to the left margin, except the last which sits at the right margin
		const targets = () => {
			const padLeft = parseFloat(getComputedStyle(track).paddingLeft);
			const max = track.scrollWidth - track.clientWidth;
			return [...cards].map((card, i) =>
				i === cards.length - 1 ? max : Math.min(max, card.offsetLeft - padLeft),
			);
		};

		const current = () => {
			const left = track.scrollLeft;
			const positions = targets();
			let best = 0;
			positions.forEach((pos, i) => {
				if (Math.abs(pos - left) < Math.abs(positions[best] - left)) best = i;
			});
			return best;
		};

		const goTo = (i: number) => {
			const index = Math.max(0, Math.min(cards.length - 1, i));
			track.scrollTo({ left: targets()[index] });
		};

		const update = () => {
			const i = current();
			prev.disabled = i === 0;
			next.disabled = i === cards.length - 1;
		};

		prev.addEventListener('click', () => goTo(current() - 1));
		next.addEventListener('click', () => goTo(current() + 1));
		track.addEventListener('scroll', update, { passive: true });
		window.addEventListener('resize', update);
		update();
	});
</script>
