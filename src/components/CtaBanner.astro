---
import { Image } from 'astro:assets';
import ArrowButton from './ArrowButton.astro';
import banner from '../assets/Banner.png';
---

<section class="cta-banner" aria-labelledby="cta-banner-title">
	<div class="content">
		<h2 class="title" id="cta-banner-title">It's never too early to build.</h2>
		<p class="text">We build for founders with no product, no revenue, and just an idea.</p>
		<ArrowButton href="#contact" label="Get a Free Roadmap" />
	</div>

	<div class="media">
		<Image
			src={banner}
			alt="Two colleagues reviewing a project on a tablet in a modern office"
			widths={[640, 960, 1280, 1536]}
			sizes="(max-width: 900px) 100vw, 48vw"
			format="webp"
			loading="lazy"
			class="media__img"
		/>
	</div>
</section>

<style>
	.cta-banner {
		display: grid;
		grid-template-columns: 52fr 48fr;
		height: 573px;
		background: #0c2b15;
		color: #ffffff;
	}

	.content {
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: flex-start;
		/* Same left edge as the impact section and footer */
		padding: 80px max(60px, calc(60 * var(--u)));
	}

	.title {
		max-width: max(480px, calc(480 * var(--u)));
		margin: 0;
		font-family: 'Inter', system-ui, sans-serif;
		font-size: max(44px, calc(44 * var(--u)));
		font-weight: 300;
		line-height: 1.1;
		letter-spacing: -0.02em;
	}

	.text {
		max-width: 440px;
		margin: 24px 0 36px;
		font-family: 'Inter', system-ui, sans-serif;
		font-size: max(18px, calc(18 * var(--u)));
		font-weight: 300;
		line-height: 1.5;
		color: rgba(255, 255, 255, 0.85);
	}

	.media {
		position: relative;
		overflow: hidden;
	}

	.media__img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 60% center;
	}

	@media (max-width: 900px) {
		.cta-banner {
			grid-template-columns: 1fr;
			height: auto;
		}

		.media {
			order: -1;
			height: 320px;
		}

		.content {
			padding: 56px 16px 64px;
		}

		.title {
			font-size: clamp(34px, 9vw, 44px);
		}

		.text {
			font-size: 16px;
		}
	}
</style>
