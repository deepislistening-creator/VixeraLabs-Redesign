---
import ArrowButton from './ArrowButton.astro';

const columns = [
	{
		title: 'Services',
		links: [
			{ label: 'MVP Build', href: '#service' },
			{ label: 'AI Agents & Automation', href: '#service' },
			{ label: 'Full Product Build', href: '#service' },
			{ label: 'Custom Enterprise', href: '#service' },
		],
	},
	{
		title: 'Work',
		links: [
			{ label: 'MVP Build', href: '#work' },
			{ label: 'AI Agents & Automation', href: '#work' },
			{ label: 'Full Product Build', href: '#work' },
			{ label: 'Custom Enterprise', href: '#work' },
		],
	},
];

const legal = [
	{ label: 'About', href: '#about' },
	{ label: 'Training', href: '#' },
	{ label: 'Terms of Use', href: '#' },
	{ label: 'Privacy Policy', href: '#' },
];

// Placeholder profile URLs: replace with the real accounts
const socials = [
	{ name: 'X', href: '#' },
	{ name: 'Instagram', href: '#' },
	{ name: 'LinkedIn', href: '#' },
];

const year = new Date().getFullYear();
---

<footer class="footer">
	<div class="top">
		<p class="tagline">Build products that get funded, acquired, and scaled.</p>

		{
			columns.map((column) => (
				<nav class="column" aria-label={column.title}>
					<h2 class="column__title">{column.title}</h2>
					<ul class="column__links">
						{column.links.map((link) => (
							<li>
								<a href={link.href}>{link.label}</a>
							</li>
						))}
					</ul>
				</nav>
			))
		}

		<div class="assist">
			<h2 class="assist__title">How can we assist you?</h2>
			<p class="assist__text">We build for founders with no product, no revenue, and just an idea.</p>
			<ArrowButton href="#contact" label="Get a Free Roadmap" />
		</div>
	</div>

	<div class="bottom">
		<a class="brand" href="/" aria-label="VIXERA LABS home">
			<img class="brand__logo" src="/assets/Logo.png" alt="" width="228" height="196" loading="lazy" />
			<span class="brand__name">VIXERA LABS</span>
		</a>

		<nav aria-label="Legal">
			<ul class="legal">
				{
					legal.map((link) => (
						<li>
							<a href={link.href}>{link.label}</a>
						</li>
					))
				}
			</ul>
		</nav>

		<div class="social">
			<span class="social__label">Follow us on</span>
			<ul class="social__links">
				{
					socials.map((social) => (
						<li>
							<a href={social.href} aria-label={`VIXERA LABS on ${social.name}`}>
								{social.name === 'X' && (
									<svg viewBox="0 0 24 24" aria-hidden="true">
										<path
											fill="currentColor"
											d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
										/>
									</svg>
								)}
								{social.name === 'Instagram' && (
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
										<rect x="3" y="3" width="18" height="18" rx="5" />
										<circle cx="12" cy="12" r="4.2" />
										<circle cx="17.3" cy="6.7" r="1" fill="currentColor" stroke="none" />
									</svg>
								)}
								{social.name === 'LinkedIn' && (
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
										<rect x="3" y="3" width="18" height="18" rx="3.5" />
										<path d="M8 10.5V16M8 7.6v.1M11.5 16v-5.5M11.5 13c0-1.6 1-2.6 2.4-2.6s2.1 1 2.1 2.6v3" stroke-linecap="round" />
									</svg>
								)}
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</div>

	<p class="copyright">© {year} VIXERA LABS</p>
</footer>

<style>
	.footer {
		--ink: #0c2b15;
		background: #f1eeea;
		padding: 72px max(60px, calc(60 * var(--u))) 48px;
		font-family: 'Inter', system-ui, sans-serif;
		color: var(--ink);
	}

	/* ---------- top row ---------- */

	.top {
		display: grid;
		grid-template-columns: minmax(0, 340px) auto auto minmax(0, 260px);
		justify-content: space-between;
		gap: 48px;
	}

	.tagline {
		margin: 0;
		font-size: 30px;
		font-weight: 300;
		line-height: 1.25;
		letter-spacing: -0.01em;
	}

	.column__title,
	.assist__title {
		margin: 0;
		font-size: 28px;
		font-weight: 400;
		line-height: 1.25;
		letter-spacing: -0.01em;
	}

	.column__links {
		display: grid;
		gap: 16px;
		margin: 24px 0 0;
		padding: 0;
		list-style: none;
	}

	.column__links a {
		font-size: 20px;
		font-weight: 300;
		color: inherit;
		text-decoration: none;
		text-underline-offset: 5px;
		text-decoration-thickness: 1px;
	}

	.column__links a:hover {
		text-decoration-line: underline;
	}

	.assist__text {
		margin: 16px 0 24px;
		font-size: 16px;
		font-weight: 400;
		line-height: 1.5;
		color: #212427;
	}

	/* ---------- bottom row ---------- */

	.bottom {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 32px;
		margin-top: 140px;
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 12px;
		color: var(--ink);
		text-decoration: none;
	}

	.brand__logo {
		display: block;
		width: auto;
		height: 36px;
	}

	.brand__name {
		font-size: 22px;
		font-weight: 700;
		letter-spacing: -0.04em;
		line-height: 1;
	}

	.legal {
		display: flex;
		flex-wrap: wrap;
		gap: 12px 36px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.legal a {
		font-size: 14px;
		font-weight: 500;
		letter-spacing: 0.02em;
		text-transform: uppercase;
		color: inherit;
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 5px;
		text-decoration-color: rgba(12, 43, 21, 0.35);
		transition: text-decoration-color 0.2s ease;
	}

	.legal a:hover {
		text-decoration-color: currentColor;
	}

	.social {
		display: flex;
		align-items: center;
		gap: 24px;
	}

	.social__label {
		font-size: 14px;
		font-weight: 400;
		letter-spacing: 0.02em;
		text-transform: uppercase;
	}

	.social__links {
		display: flex;
		gap: 20px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.social__links a {
		display: grid;
		place-items: center;
		width: 24px;
		height: 24px;
		color: inherit;
		transition: opacity 0.2s ease;
	}

	.social__links a:hover {
		opacity: 0.6;
	}

	.social__links svg {
		width: 22px;
		height: 22px;
	}

	.copyright {
		margin: 56px 0 0;
		text-align: center;
		font-size: 14px;
		letter-spacing: 0.02em;
	}

	.footer a:focus-visible {
		outline: 2px solid var(--ink);
		outline-offset: 3px;
		border-radius: 4px;
	}

	/* ---------- responsive ---------- */

	@media (max-width: 1100px) {
		.top {
			grid-template-columns: 1fr 1fr;
			row-gap: 56px;
		}

		.bottom {
			flex-wrap: wrap;
		}
	}

	@media (max-width: 640px) {
		.footer {
			padding: 56px 16px 32px;
		}

		.top {
			grid-template-columns: 1fr;
			row-gap: 44px;
		}

		.tagline {
			font-size: 26px;
		}

		.bottom {
			flex-direction: column;
			align-items: flex-start;
			gap: 28px;
			margin-top: 72px;
		}

		.copyright {
			text-align: left;
			margin-top: 40px;
		}
	}
</style>
