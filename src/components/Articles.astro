---
import { Image } from 'astro:assets';
import ArrowButton from './ArrowButton.astro';
import { articles } from '../data/articles';
---

<section class="articles" aria-labelledby="articles-title">
	<div class="head">
		<p class="eyebrow">Latest articles</p>
		<h2 class="title" id="articles-title">Practical reads for every stage of the build.</h2>
		<p class="subtitle">
			Costs, timelines and the decisions behind them.<br />
			Written from the products we've shipped, not from theory.
		</p>
	</div>

	<ul class="cards">
		{
			articles.map((item) => (
				<li class="card">
					<div class="card__media" style={`--placeholder:${item.placeholder}`}>
						{item.image && (
							<Image
								src={item.image}
								alt={item.alt ?? ''}
								widths={[480, 720, 960]}
								sizes="(max-width: 640px) 100vw, (max-width: 1100px) 50vw, 33vw"
								format="webp"
								loading="lazy"
								class="card__img"
							/>
						)}
					</div>

					<div class="card__box">
						<p class="card__category">{item.category}</p>
						<p class="card__meta">{item.readTime}</p>
						<h3 class="card__title">{item.title}</h3>

						<div class="card__more">
							<p class="card__excerpt">{item.excerpt}</p>
							<ArrowButton href={`/insights/${item.slug}`} label="Read Post" class="card__btn" />
						</div>
					</div>
				</li>
			))
		}
	</ul>
</section>

<style>
	.articles {
		--pad: max(60px, calc(60 * var(--u)));
		background: #ffffff;
		padding: 0 var(--pad) max(100px, calc(100 * var(--u)));
		font-family: 'Inter', system-ui, sans-serif;
		color: #0c2b15;
	}

	/* ---------- heading: same treatment as the Principles section ---------- */

	.eyebrow {
		margin: 0;
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: #0c2b15;
	}

	.title {
		margin: 12px 0 0;
		font-size: max(44px, calc(44 * var(--u)));
		font-weight: 400;
		line-height: 1.15;
		letter-spacing: -0.02em;
		color: #111111;
	}

	.subtitle {
		margin: 12px 0 0;
		font-size: 16px;
		font-weight: 300;
		line-height: 1.4;
		color: #5e5e5e;
	}

	/* ---------- cards: image on top, then label, meta, title ---------- */

	.cards {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: max(48px, calc(48 * var(--u))) 24px;
		margin: 40px 0 0;
		padding: 0;
		list-style: none;
	}

	.card {
		position: relative;
		display: flex;
		flex-direction: column;
		overflow: hidden;
	}

	.card__media {
		position: relative;
		aspect-ratio: 4 / 3;
		overflow: hidden;
		background: var(--placeholder);
	}

	/* Soft tint so the text panel reads as part of the card against the white section */
	.card__box {
		flex: 1;
		display: flex;
		flex-direction: column;
		padding: 24px;
		background: #f5f4f0;
	}

	.card__img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.5s cubic-bezier(0.65, 0, 0.35, 1);
	}

	.card:hover .card__img {
		transform: scale(1.04);
	}

	.card__category {
		margin: 0;
		font-size: 13px;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: #1d7a3a;
	}

	.card__meta {
		margin: 8px 0 0;
		font-size: 14px;
		font-weight: 400;
		color: #5e5e5e;
	}

	.card__title {
		margin: 10px 0 0;
		font-size: max(26px, calc(26 * var(--u)));
		font-weight: 300;
		line-height: 1.25;
		letter-spacing: -0.01em;
		color: #111111;
	}

	.card__excerpt {
		margin: 10px 0 0;
		font-size: 15px;
		font-weight: 300;
		line-height: 1.5;
		color: #5e5e5e;
	}

	/* Takes the leftover height so the button can sit at the bottom of the card */
	.card__more {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 24px;
	}

	/* :global because the class lands on the ArrowButton's own <a> */
	.card__more :global(.card__btn) {
		align-self: flex-start;
		margin-top: auto;
	}

	/*
	 * Hover reveal, same motion as the Principles cards: at rest the card reads as image on top,
	 * text below; on hover the content box grows up to fill the card and the excerpt and button
	 * fade in. Touch screens have no hover, so they keep the stacked layout with everything showing.
	 */
	@media (hover: hover) and (min-width: 641px) {
		.card {
			/* Image area (4:3 of the width) plus the resting text box */
			aspect-ratio: 5 / 6;
		}

		.card__media {
			position: absolute;
			inset: 0;
			aspect-ratio: auto;
		}

		.card__box {
			--ease: cubic-bezier(0.65, 0, 0.35, 1);
			position: absolute;
			left: 0;
			right: 0;
			bottom: 0;
			/* Fits category, read time and a title of up to three lines (narrow 3-column widths) */
			height: max(210px, calc(210 * var(--u)));
			overflow: hidden;
			-webkit-backdrop-filter: blur(20px);
			backdrop-filter: blur(20px);
			transition:
				height 0.35s var(--ease),
				padding 0.35s var(--ease),
				background-color 0.35s var(--ease);
		}

		/* Open: the box fills the card, turning to glass so the image shows faintly behind. Only the top padding grows, so the text doesn't shift sideways */
		.card:hover .card__box,
		.card:focus-within .card__box {
			height: 100%;
			padding-top: 36px;
			background: rgba(245, 244, 240, 0.85);
		}

		.card__more {
			opacity: 0;
			transform: translateY(8px);
			transition:
				opacity 0.2s ease,
				transform 0.2s ease;
		}

		.card:hover .card__more,
		.card:focus-within .card__more {
			opacity: 1;
			transform: none;
			transition:
				opacity 0.3s ease 0.15s,
				transform 0.3s ease 0.15s;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.card__img,
		.card__box,
		.card__more {
			transition: none !important;
		}
	}

	/* ---------- responsive ---------- */

	@media (max-width: 1100px) {
		.cards {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 640px) {
		.articles {
			--pad: 16px;
			padding-bottom: 72px;
		}

		.title {
			font-size: clamp(34px, 9vw, 44px);
		}

		.subtitle br {
			display: none;
		}

		.cards {
			grid-template-columns: 1fr;
			gap: 40px;
		}

		.card__title {
			font-size: 22px;
		}
	}
</style>
