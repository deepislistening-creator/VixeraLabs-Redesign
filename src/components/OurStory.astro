---
interface Milestone {
	year: string;
	title: string;
	text: string;
}

// [Bracketed] values are placeholders to fill in later
const milestones: Milestone[] = [
	{
		year: '2015',
		title: 'We start building',
		text: 'Harsh and [Brother] build their first apps and games, years before ChatGPT existed.',
	},
	{
		year: '[20__]',
		title: '100M+ downloads',
		text: 'Kids’ games built by [Brother] pass 100 million combined downloads.',
	},
	{
		year: '[20__]',
		title: 'Founders start raising',
		text: 'Companies we build for raise from Shark Tank, VCs and angels: $40M+ to date.',
	},
	{
		year: '[20__]',
		title: 'First acquisitions',
		text: 'Client companies built on our work start getting acquired. Five so far.',
	},
	{
		year: '[20__]',
		title: 'Enterprise & public sector',
		text: 'Healthcare software, a Chicago alderman’s office, and the largest credit institutions in Saudi Arabia and Southeast Asia.',
	},
	{
		year: '2026',
		title: 'Focused on AI automation',
		text: 'We focus on AI automation and infrastructure: systems that run operations every day.',
	},
];
---

{/* Runs during parsing, before the rows paint, so the hidden start states never flash. Without JS nothing is hidden */}
<script is:inline>document.documentElement.classList.add('js');</script>

<section class="story" aria-labelledby="story-title">
	<div class="head">
		<p class="eyebrow">Our story</p>
		<h2 class="title" id="story-title">From apps to AI automation</h2>
		<p class="intro">
			Vixera Labs started in 2015 building apps and games. Over eleven years we moved from consumer apps to funded
			startups, then to enterprise and public-sector systems, and in 2026 we focused fully on AI automation.
		</p>
	</div>

	<ol class="rows">
		{
			milestones.map((item) => (
				<li class="row">
					<p class="row__year">{item.year}</p>
					<div class="row__body">
						<h3 class="row__title">{item.title}</h3>
						<p class="row__text">{item.text}</p>
					</div>
				</li>
			))
		}
	</ol>
</section>

<style>
	.story {
		--pad: max(60px, calc(60 * var(--u)));
		--ink: #0c2b15;
		--body: #3b4a40;
		--line: #d9dcd8;
		--accent: #2f9e44;
		--ease: cubic-bezier(0.22, 1, 0.36, 1);
		background: #ffffff;
		padding: max(100px, calc(100 * var(--u))) var(--pad);
		font-family: 'Inter', system-ui, sans-serif;
		color: var(--ink);
	}

	/* ---------- heading ---------- */

	.eyebrow {
		margin: 0;
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: #2f6b25;
	}

	.title {
		margin: 12px 0 0;
		font-family: 'Source Serif 4', Georgia, serif;
		font-size: max(44px, calc(44 * var(--u)));
		font-weight: 400;
		line-height: 1.15;
		letter-spacing: -0.01em;
		color: var(--ink);
	}

	.intro {
		max-width: max(720px, calc(720 * var(--u)));
		margin: 16px 0 0;
		font-size: max(18px, calc(18 * var(--u)));
		font-weight: 300;
		line-height: 1.6;
		color: var(--body);
	}

	/* ---------- timeline rows ---------- */

	.rows {
		margin: max(56px, calc(56 * var(--u))) 0 0;
		padding: 0;
		list-style: none;
	}

	.row {
		position: relative;
		display: grid;
		grid-template-columns: max(260px, calc(260 * var(--u))) 1fr;
		align-items: baseline;
		padding: max(30px, calc(30 * var(--u))) 0;
	}

	/* Top divider on every row, plus one under the last row */
	.row::before,
	.row:last-child::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		height: 1px;
		background: var(--line);
		transform-origin: left;
	}

	.row::before {
		top: 0;
	}

	.row:last-child::after {
		bottom: 0;
	}

	.row__year {
		margin: 0;
		font-family: 'Source Serif 4', Georgia, serif;
		font-size: max(56px, calc(56 * var(--u)));
		font-weight: 400;
		line-height: 1;
		letter-spacing: -0.02em;
		font-variant-numeric: lining-nums;
		color: var(--ink);
		transition: color 0.5s ease;
	}

	/* Middle-of-screen row and hovered row pick up the accent; the latest year always has it */
	.row.on .row__year,
	.row:hover .row__year,
	.row:last-child .row__year {
		color: var(--accent);
	}

	.row__title {
		margin: 0;
		font-size: max(22px, calc(22 * var(--u)));
		font-weight: 600;
		line-height: 1.3;
		color: var(--ink);
	}

	.row__text {
		max-width: max(640px, calc(640 * var(--u)));
		margin: 8px 0 0;
		font-size: max(17px, calc(17 * var(--u)));
		font-weight: 400;
		line-height: 1.6;
		color: var(--body);
	}

	/* ---------- reveal: start states only apply when JS is running ---------- */

	:global(.js) .row::before,
	:global(.js) .row:last-child::after {
		transform: scaleX(0);
		transition: transform 1s var(--ease);
	}

	:global(.js) .row:last-child::after {
		transition-delay: 0.3s;
	}

	:global(.js) .row__year,
	:global(.js) .row__body {
		opacity: 0;
		transform: translateY(22px);
		transition:
			opacity 0.8s var(--ease),
			transform 0.8s var(--ease),
			color 0.5s ease;
	}

	:global(.js) .row__body {
		transition-delay: 0.12s;
	}

	:global(.js) .row.in::before,
	:global(.js) .row.in:last-child::after {
		transform: scaleX(1);
	}

	:global(.js) .row.in .row__year,
	:global(.js) .row.in .row__body {
		opacity: 1;
		transform: none;
	}

	@media (prefers-reduced-motion: reduce) {
		:global(.js) .row::before,
		:global(.js) .row:last-child::after,
		:global(.js) .row__year,
		:global(.js) .row__body {
			opacity: 1;
			transform: none;
			transition: none;
		}
	}

	/* ---------- responsive ---------- */

	@media (max-width: 900px) {
		.row {
			grid-template-columns: 1fr;
			row-gap: 14px;
		}

		.row__year {
			font-size: 40px;
		}
	}

	@media (max-width: 640px) {
		.story {
			--pad: 16px;
			padding-top: 72px;
			padding-bottom: 72px;
		}

		.title {
			font-size: clamp(34px, 9vw, 44px);
		}

		.intro {
			font-size: 17px;
		}

		.rows {
			margin-top: 40px;
		}

		.row {
			padding: 26px 0;
		}

		.row__title {
			font-size: 20px;
		}

		.row__text {
			font-size: 16px;
		}
	}
</style>

<script>
	const rows = document.querySelectorAll<HTMLElement>('.story .row');

	if ('IntersectionObserver' in window) {
		// Plays once per row as it scrolls into view
		const reveal = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (!entry.isIntersecting) return;
					entry.target.classList.add('in');
					reveal.unobserve(entry.target);
				});
			},
			{ rootMargin: '0px 0px -18% 0px' },
		);

		// Highlights whichever row sits in the middle band of the screen
		const active = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => entry.target.classList.toggle('on', entry.isIntersecting));
			},
			{ rootMargin: '-45% 0px -45% 0px' },
		);

		rows.forEach((row) => {
			reveal.observe(row);
			active.observe(row);
		});
	} else {
		rows.forEach((row) => row.classList.add('in'));
	}
</script>
