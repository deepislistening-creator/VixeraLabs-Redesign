---
// App-window frame for the animated service mockups
interface Props {
	title: string;
	// Shows an "Example" tag, for mockups with made-up names and amounts
	example?: boolean;
}

const { title, example = false } = Astro.props;
---

<div class="win">
	<div class="win__bar">
		<span class="win__dots"><i></i><i></i><i></i></span>
		<span class="win__title">{title}</span>
		{example && <span class="win__example">Example</span>}
	</div>
	<div class="win__body">
		<slot />
	</div>
</div>

<style>
	.win {
		width: 100%;
		overflow: hidden;
		border-radius: 14px;
		background: #ffffff;
		box-shadow:
			0 30px 60px -20px rgba(0, 0, 0, 0.5),
			0 0 0 1px rgba(255, 255, 255, 0.08);
		font-family: 'Inter', system-ui, sans-serif;
		color: #1a1d1a;
		text-align: left;
	}

	.win__bar {
		display: flex;
		align-items: center;
		gap: 12px;
		height: 36px;
		padding: 0 14px;
		border-bottom: 1px solid #eceeea;
		background: #fafbf9;
	}

	.win__dots {
		display: flex;
		gap: 6px;
	}

	.win__dots i {
		width: 9px;
		height: 9px;
		border-radius: 50%;
		background: #dcdfd9;
	}

	.win__title {
		font-size: 12px;
		font-weight: 500;
		color: #6b716a;
	}

	.win__example {
		margin-left: auto;
		padding: 2px 8px;
		border-radius: 999px;
		background: #eef0ec;
		font-size: 10.5px;
		font-weight: 600;
		letter-spacing: 0.04em;
		color: #6b716a;
	}

	.win__body {
		padding: 18px;
	}
</style>
