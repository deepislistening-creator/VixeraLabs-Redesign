---
import MockWindow from './MockWindow.astro';

// Steps appear at `data-at` ms and hide at `data-until`; Services.astro plays them
const docLines = ['90%', '70%', '84%', '60%', '78%', '50%', '88%', '64%'];

const fields = [
	{ at: 900, label: 'Business', value: 'Lumen Foods' },
	{ at: 1200, label: 'Annual revenue', value: '$1.2M' },
	{ at: 1500, label: 'Credit score', value: '712' },
	{ at: 1800, label: 'Documents', value: '4 of 4' },
];

const queue = [
	{ at: undefined, id: '#2046', name: 'Bright Dental', review: false },
	{ at: undefined, id: '#2047', name: 'Kora Logistics', review: false },
	{ at: 2500, id: '#2048', name: 'Lumen Foods', review: false },
	{ at: 3200, id: '#2049', name: 'Vela Studio', review: true },
];
---

<div class="custom">
	<MockWindow title="Custom OS · Credit checks">
		<div class="top">
			<div class="doc">
				<div class="doc__page">
					<p class="doc__name">Loan application #2048</p>
					{docLines.map((width) => <span class="doc__line" style={`width:${width}`} />)}
					<span class="scan" data-at="400" data-until="2100"></span>
				</div>
				<p class="doc__file">PDF · 6 pages</p>
			</div>

			<ul class="fields">
				{
					fields.map((field) => (
						<li data-at={field.at}>
							<span class="fields__label">{field.label}</span>
							<span class="fields__value">{field.value}</span>
							<span class="tick">
								<svg viewBox="0 0 12 12" fill="none">
									<path
										d="M2.5 6.2 5 8.5l4.5-5"
										stroke="currentColor"
										stroke-width="1.8"
										stroke-linecap="round"
										stroke-linejoin="round"
									/>
								</svg>
							</span>
						</li>
					))
				}
			</ul>
		</div>

		<div class="queue">
			{
				queue.map((row) => (
					<div class:list={['queue__row', { 'is-new': row.at }]} data-at={row.at}>
						<span class="queue__id">{row.id}</span>
						<span class="queue__name">
							{row.name}
							{row.review && <span class="queue__note">Sent to Maya</span>}
						</span>
						<span class:list={['status', row.review ? 'status--review' : 'status--ok']}>
							{row.review ? 'Needs review' : 'Approved'}
						</span>
					</div>
				))
			}
		</div>

		<p class="foot" data-at="4000">
			<svg viewBox="0 0 12 12" fill="none">
				<path
					d="M2.5 6.2 5 8.5l4.5-5"
					stroke="currentColor"
					stroke-width="1.8"
					stroke-linecap="round"
					stroke-linejoin="round"
				/>
			</svg>
			CRM updated automatically
		</p>
	</MockWindow>
</div>

<style>
	.custom {
		width: 100%;
		max-width: 460px;
	}

	.top {
		display: grid;
		grid-template-columns: 112px minmax(0, 1fr);
		gap: 14px;
		align-items: start;
	}

	.doc__page {
		position: relative;
		display: grid;
		align-content: start;
		gap: 7px;
		aspect-ratio: 3 / 4;
		overflow: hidden;
		padding: 10px;
		border: 1px solid #e3e6e1;
		border-radius: 8px;
		background: #ffffff;
	}

	.doc__name {
		margin: 0 0 3px;
		font-size: 9px;
		font-weight: 700;
		line-height: 1.3;
		color: #111111;
	}

	.doc__line {
		height: 4px;
		border-radius: 2px;
		background: #e9ece7;
	}

	/* Green line sweeping down the page while it's read */
	.scan {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 2px;
		background: #3ddc6b;
		box-shadow: 0 0 12px 3px rgba(61, 220, 107, 0.55);
	}

	.scan:global(.on) {
		animation: scan 0.8s ease-in-out infinite alternate;
	}

	@keyframes scan {
		to {
			top: calc(100% - 2px);
		}
	}

	.doc__file {
		margin: 6px 0 0;
		font-size: 10.5px;
		text-align: center;
		color: #7a8079;
	}

	.fields {
		display: grid;
		gap: 7px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.fields li {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto 16px;
		align-items: center;
		gap: 8px;
		padding: 8px 10px;
		border-radius: 8px;
		background: #f5f7f4;
		font-size: 12px;
	}

	.fields__label {
		color: #6b716a;
	}

	.fields__value {
		font-weight: 600;
		color: #111111;
	}

	.tick {
		display: grid;
		place-items: center;
		width: 16px;
		height: 16px;
		border-radius: 50%;
		background: #96f878;
		color: #0c2b15;
	}

	.tick svg {
		width: 10px;
		height: 10px;
	}

	.queue {
		margin-top: 14px;
		overflow: hidden;
		border: 1px solid #e7eae5;
		border-radius: 10px;
	}

	.queue__row {
		display: grid;
		grid-template-columns: 48px minmax(0, 1fr) auto;
		align-items: center;
		gap: 10px;
		padding: 8px 12px;
		font-size: 12px;
		color: #1a1d1a;
	}

	.queue__row + .queue__row {
		border-top: 1px solid #eef0ec;
	}

	.queue__row.is-new {
		background: #fbfdf9;
	}

	.queue__id {
		font-variant-numeric: tabular-nums;
		color: #8a9089;
	}

	.queue__name {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0 8px;
		font-weight: 500;
	}

	.queue__note {
		font-size: 10.5px;
		font-weight: 400;
		color: #8a9089;
	}

	.status {
		padding: 3px 8px;
		border-radius: 6px;
		font-size: 11px;
		font-weight: 600;
	}

	.status--ok {
		background: #e8fbe2;
		color: #1d6b33;
	}

	.status--review {
		background: #fff1d6;
		color: #8a5a00;
	}

	.foot {
		display: flex;
		align-items: center;
		gap: 6px;
		margin: 12px 0 0;
		font-size: 12px;
		font-weight: 600;
		color: #1d6b33;
	}

	.foot svg {
		width: 12px;
		height: 12px;
	}

	/* Phones: narrower page thumbnail, and each field's value sits under its label so they don't collide */
	@media (max-width: 520px) {
		.top {
			grid-template-columns: 84px minmax(0, 1fr);
			gap: 10px;
		}

		.fields li {
			grid-template-columns: minmax(0, 1fr) 16px;
			row-gap: 1px;
			padding: 6px 9px;
		}

		.fields__label {
			font-size: 10.5px;
		}

		.fields__value {
			grid-row: 2;
		}

		.tick {
			grid-column: 2;
			grid-row: 1 / span 2;
		}
	}
</style>
