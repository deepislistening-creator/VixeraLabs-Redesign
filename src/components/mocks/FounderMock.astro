---
import MockWindow from './MockWindow.astro';

// Three short Slack exchanges take turns in the same spot: you or someone on your team @mentions an agent,
// and it replies with the result. Together they tell one story: you hand off work, your team gets answers
// without asking you, and you see who is waiting on you.
// Steps appear at `data-at` ms and hide at `data-until`; Services.astro plays them while the card is on screen.
// Without the script, only the last exchange shows, because it has no `until`.
const tools = ['Gmail', 'Calendar', 'Slack', 'Jira', 'Stripe'];

interface Person {
	name: string;
	initial: string;
	// Someone on the founder's team, shown with a different avatar colour
	team?: boolean;
}

interface Chat {
	from: Person;
	agent: string;
	initials: string;
	ask: string;
	reply: string;
	card: { title: string; rows: [string, string][] };
	status: string;
	tone: 'done' | 'waiting';
	actions?: string[];
	at: number;
	until?: number;
}

const you: Person = { name: 'You', initial: 'Y' };
const sam: Person = { name: 'Sam', initial: 'S', team: true };

const chats: Chat[] = [
	{
		from: you,
		agent: 'Task Manager',
		initials: 'TM',
		ask: 'give the case study to Sam, due Friday',
		reply: 'Done. Sam has it in Jira.',
		card: {
			title: 'Jira · Publish the case study',
			rows: [
				['Owner', 'Sam'],
				['Due', 'Friday'],
			],
		},
		status: 'Assigned',
		tone: 'done',
		at: 900,
		until: 5900,
	},
	{
		from: sam,
		agent: 'Payment Recovery',
		initials: 'PR',
		ask: 'has Acme paid yet?',
		reply: 'Not yet. They’re 12 days late, so I drafted a reminder.',
		card: {
			title: 'Acme Co · Invoice 1042',
			rows: [
				['Amount', '$1,800'],
				['Due', '12 days ago'],
			],
		},
		status: 'Waiting on you',
		tone: 'waiting',
		actions: ['Send reminder', 'Edit'],
		at: 6300,
		until: 11600,
	},
	{
		from: you,
		agent: 'Chief of Staff',
		initials: 'CS',
		ask: 'who’s waiting on me?',
		reply: '3 people are waiting on you.',
		card: {
			title: 'Waiting on you',
			rows: [
				['Sam', 'Approve the Acme reminder'],
				['Priya', 'Refund over $500'],
				['Design team', 'Homepage sign-off'],
			],
		},
		status: '3 waiting',
		tone: 'waiting',
		actions: ['Open list'],
		at: 12000,
	},
];
---

<div class="founder">
	<ul class="tools">
		{
			tools.map((tool, i) => (
				<li data-at={200 + i * 150}>
					<span class="tools__dot" />
					{tool}
				</li>
			))
		}
	</ul>

	<MockWindow title="# ops" example>
		<div class="chats">
			{
				chats.map((chat) => (
					<div class="chat" data-at={chat.at} data-until={chat.until}>
						<div class="msg">
							<span class:list={['avatar', 'avatar--person', { 'avatar--team': chat.from.team }]}>
								{chat.from.initial}
							</span>
							<div class="msg__main">
								<p class="meta">
									<strong>{chat.from.name}</strong>
									<span class="time">9:41 AM</span>
								</p>
								<p class="text">
									<span class="mention">@{chat.agent}</span> {chat.ask}
								</p>
							</div>
						</div>

						<div class="msg" data-at={chat.at + 600}>
							<span class="avatar">{chat.initials}</span>
							<div class="msg__main">
								<p class="meta">
									<strong>{chat.agent}</strong>
									<span class="badge">APP</span>
									<span class="time">9:41 AM</span>
								</p>

								<div class="stack">
									<span class="typing" data-at={chat.at + 600} data-until={chat.at + 1400}>
										<i />
										<i />
										<i />
									</span>
									<p class="text" data-at={chat.at + 1400}>
										{chat.reply}
									</p>
								</div>

								<div class="card" data-at={chat.at + 1800}>
									<p class="card__title">{chat.card.title}</p>
									{chat.card.rows.map(([label, value]) => (
										<p class="card__row">
											<span>{label}</span>
											<strong>{value}</strong>
										</p>
									))}
								</div>

								<div class="foot" data-at={chat.at + 2300}>
									<span class:list={['status', `status--${chat.tone}`]}>{chat.status}</span>
									{chat.actions?.map((label, i) => (
										<span class:list={['btn', { 'btn--dark': i === 0 }]}>{label}</span>
									))}
								</div>
							</div>
						</div>
					</div>
				))
			}
		</div>
	</MockWindow>
</div>

<style>
	.founder {
		width: 100%;
		max-width: 460px;
		display: grid;
		gap: 16px;
	}

	.tools {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 8px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.tools li {
		display: inline-flex;
		align-items: center;
		gap: 7px;
		padding: 6px 12px;
		border: 1px solid rgba(255, 255, 255, 0.16);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.08);
		font-family: 'Inter', system-ui, sans-serif;
		font-size: 12px;
		font-weight: 500;
		color: #e3fddb;
	}

	.tools__dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: #96f878;
		box-shadow: 0 0 0 3px rgba(150, 248, 120, 0.2);
	}

	/* The exchanges take turns in one spot, so the window keeps its size */
	.chats {
		display: grid;
	}

	.chat {
		grid-area: 1 / 1;
		display: grid;
		align-content: start;
		gap: 14px;
	}

	.msg {
		display: flex;
		gap: 12px;
	}

	.avatar {
		flex: none;
		display: grid;
		place-items: center;
		width: 36px;
		height: 36px;
		border-radius: 9px;
		background: #0c2b15;
		font-size: 13px;
		font-weight: 700;
		color: #96f878;
	}

	/* People (you and your team) look different from the agents */
	.avatar--person {
		background: #e6e9e4;
		color: #4b514a;
	}

	.avatar--team {
		background: #e9e3fb;
		color: #5b3fa0;
	}

	.msg__main {
		flex: 1;
		min-width: 0;
	}

	.meta {
		display: flex;
		align-items: center;
		gap: 8px;
		margin: 0;
		font-size: 14px;
	}

	.badge {
		padding: 2px 5px;
		border-radius: 4px;
		background: #eef0ec;
		font-size: 10px;
		font-weight: 600;
		color: #5d635c;
	}

	.time {
		font-size: 12px;
		color: #8a9089;
	}

	.text {
		margin: 2px 0 0;
		font-size: 14px;
		line-height: 20px;
	}

	.mention {
		padding: 1px 4px;
		border-radius: 4px;
		background: #e3f8d9;
		font-weight: 600;
		color: #0c2b15;
	}

	/* Typing dots and the reply share one spot */
	.stack {
		display: grid;
		margin-top: 2px;
	}

	.stack > * {
		grid-area: 1 / 1;
	}

	.typing {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		height: 20px;
	}

	.typing i {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: #9aa199;
		animation: blink 1s infinite;
	}

	.typing i:nth-child(2) {
		animation-delay: 0.15s;
	}

	.typing i:nth-child(3) {
		animation-delay: 0.3s;
	}

	@keyframes blink {
		0%,
		80%,
		100% {
			opacity: 0.3;
		}
		40% {
			opacity: 1;
		}
	}

	.card {
		margin-top: 10px;
		padding: 10px 12px;
		border: 1px solid #e6e9e4;
		border-radius: 10px;
		background: #fafbf9;
	}

	.card__title {
		margin: 0 0 4px;
		font-size: 12px;
		font-weight: 600;
		color: #6b716a;
	}

	.card__row {
		display: flex;
		justify-content: space-between;
		gap: 12px;
		margin: 0;
		padding: 6px 0;
		font-size: 13px;
		color: #4b514a;
	}

	.card__row + .card__row {
		border-top: 1px solid #eceeea;
	}

	.card__row strong {
		font-weight: 600;
		color: #111111;
	}

	.foot {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px;
		margin-top: 10px;
	}

	.status {
		padding: 4px 9px;
		border-radius: 999px;
		font-size: 11.5px;
		font-weight: 600;
	}

	.status--done {
		background: #e4f8dc;
		color: #1d6b2c;
	}

	.status--waiting {
		background: #fff3dc;
		color: #8a5a00;
	}

	.btn {
		padding: 6px 11px;
		border: 1px solid #dfe3dd;
		border-radius: 8px;
		font-size: 12px;
		font-weight: 600;
		color: #2c312b;
	}

	.btn--dark {
		border-color: #0c2b15;
		background: #0c2b15;
		color: #ffffff;
	}
</style>
