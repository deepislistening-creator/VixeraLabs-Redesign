---
import MockWindow from './MockWindow.astro';

// Steps appear at `data-at` ms; Services.astro plays them while the card is on screen
const tools = ['Gmail', 'Calendar', 'Slack', 'Zoom', 'Notion'];

const brief = [
	{ at: 2300, title: '3 things need you today', detail: '', alert: true },
	{ at: 2800, title: '11:00 Acme call', detail: 'prep notes ready' },
	{ at: 3300, title: 'Follow-up to Priya', detail: 'drafted in your voice' },
	{ at: 3800, title: 'Investor update', detail: 'first draft ready' },
	{ at: 4300, title: '2 promises', detail: 'due this week' },
];
---

<div class="founder">
	<ul class="tools">
		{
			tools.map((tool, i) => (
				<li data-at={200 + i * 150}>
					<span class="tools__dot" />
					{tool}
				</li>
			))
		}
	</ul>

	<MockWindow title="# daily-brief">
		<div class="msg">
			<span class="avatar">F</span>
			<div class="msg__main">
				<p class="meta">
					<strong>Founder OS</strong>
					<span class="badge">APP</span>
					<span class="time">7:30 AM</span>
				</p>

				<div class="stack">
					<span class="typing" data-at="1100" data-until="1900"><i></i><i></i><i></i></span>
					<p class="greeting" data-at="1900">Good morning. Here's your Tuesday.</p>
				</div>

				<ul class="brief">
					{
						brief.map((item) => (
							<li data-at={item.at} class:list={{ 'is-alert': item.alert }}>
								<span class="icon">
									{item.alert ? (
										'!'
									) : (
										<svg viewBox="0 0 12 12" fill="none">
											<path
												d="M2.5 6.2 5 8.5l4.5-5"
												stroke="currentColor"
												stroke-width="1.8"
												stroke-linecap="round"
												stroke-linejoin="round"
											/>
										</svg>
									)}
								</span>
								<span>
									<strong>{item.title}</strong>
									{item.detail && ` · ${item.detail}`}
								</span>
							</li>
						))
					}
				</ul>

				<div class="actions" data-at="5000">
					<span class="btn btn--dark">Open brief</span>
					<span class="btn">Approve follow-up</span>
				</div>
			</div>
		</div>
	</MockWindow>
</div>

<style>
	.founder {
		width: 100%;
		max-width: 460px;
		display: grid;
		gap: 16px;
	}

	.tools {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 8px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.tools li {
		display: inline-flex;
		align-items: center;
		gap: 7px;
		padding: 6px 12px;
		border: 1px solid rgba(255, 255, 255, 0.16);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.08);
		font-family: 'Inter', system-ui, sans-serif;
		font-size: 12px;
		font-weight: 500;
		color: #e3fddb;
	}

	.tools__dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: #96f878;
		box-shadow: 0 0 0 3px rgba(150, 248, 120, 0.2);
	}

	.msg {
		display: flex;
		gap: 12px;
	}

	.avatar {
		flex: none;
		display: grid;
		place-items: center;
		width: 36px;
		height: 36px;
		border-radius: 9px;
		background: #0c2b15;
		font-size: 15px;
		font-weight: 700;
		color: #96f878;
	}

	.msg__main {
		flex: 1;
		min-width: 0;
	}

	.meta {
		display: flex;
		align-items: center;
		gap: 8px;
		margin: 0;
		font-size: 14px;
	}

	.badge {
		padding: 2px 5px;
		border-radius: 4px;
		background: #eef0ec;
		font-size: 10px;
		font-weight: 600;
		color: #5d635c;
	}

	.time {
		font-size: 12px;
		color: #8a9089;
	}

	/* Typing dots and the greeting share one spot */
	.stack {
		display: grid;
		margin-top: 4px;
	}

	.stack > * {
		grid-area: 1 / 1;
	}

	.greeting {
		margin: 0;
		font-size: 14px;
		line-height: 20px;
	}

	.typing {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		height: 20px;
	}

	.typing i {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: #9aa199;
		animation: blink 1s infinite;
	}

	.typing i:nth-child(2) {
		animation-delay: 0.15s;
	}

	.typing i:nth-child(3) {
		animation-delay: 0.3s;
	}

	@keyframes blink {
		0%,
		80%,
		100% {
			opacity: 0.3;
		}
		40% {
			opacity: 1;
		}
	}

	.brief {
		display: grid;
		gap: 8px;
		margin: 12px 0 0;
		padding: 0;
		list-style: none;
	}

	.brief li {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 9px 12px;
		border-radius: 10px;
		background: #f5f7f4;
		font-size: 13px;
		line-height: 1.35;
		color: #4b514a;
	}

	.brief strong {
		font-weight: 600;
		color: #111111;
	}

	.icon {
		flex: none;
		display: grid;
		place-items: center;
		width: 20px;
		height: 20px;
		border-radius: 50%;
		background: #96f878;
		color: #0c2b15;
	}

	.icon svg {
		width: 12px;
		height: 12px;
	}

	.brief li.is-alert {
		background: #fff6e5;
	}

	.is-alert .icon {
		background: #ffb020;
		font-size: 12px;
		font-weight: 700;
		color: #ffffff;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: 14px;
	}

	.btn {
		padding: 7px 12px;
		border: 1px solid #dfe3dd;
		border-radius: 8px;
		font-size: 12px;
		font-weight: 600;
		color: #2c312b;
	}

	.btn--dark {
		border-color: #0c2b15;
		background: #0c2b15;
		color: #ffffff;
	}
</style>
