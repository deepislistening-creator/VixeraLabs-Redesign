---
import MockWindow from './MockWindow.astro';

// Steps appear at `data-at` ms and hide at `data-until`; Services.astro plays them
---

<div class="brand">
	<MockWindow title="Brand OS · Live feed">
		<div class="sources">
			<span class="live"><i></i>Live</span>
			<span>Reddit</span>
			<span>X</span>
			<span>LinkedIn</span>
		</div>

		<article class="post" data-at="300">
			<p class="post__meta"><span class="post__sub">r/startups</span> · 4 min ago</p>
			<p class="post__title">
				Can anyone recommend a tool for tracking customer feedback? Our spreadsheet is falling apart.
			</p>
			<p class="post__stats">12 upvotes · 8 comments</p>
			<div class="tags">
				<span class="tag tag--intent" data-at="1300">Buying intent: high</span>
				<span class="tag" data-at="1700">Matches your product</span>
			</div>
		</article>

		<div class="spacer"></div>
	</MockWindow>

	<div class="alert" data-at="2600">
		<p class="alert__meta">
			<span class="avatar">B</span>
			<strong>Brand OS</strong>
			<span class="time">now</span>
		</p>
		<p class="alert__text">New buying-intent post on Reddit. Suggested reply:</p>
		<blockquote>
			“We hit the same wall at about 30 customers. What fixed it for us was tagging feedback by account, not
			by…”
		</blockquote>

		<div class="actions">
			<div class="btns" data-until="4400">
				<span class="btn btn--dark">Approve</span>
				<span class="btn">Edit</span>
			</div>
			<span class="done" data-at="4400">
				<svg viewBox="0 0 12 12" fill="none">
					<path
						d="M2.5 6.2 5 8.5l4.5-5"
						stroke="currentColor"
						stroke-width="1.8"
						stroke-linecap="round"
						stroke-linejoin="round"
					/>
				</svg>
				Approved by you
			</span>
			<span class="cursor" data-at="3500" data-until="4400">
				<svg viewBox="0 0 16 20" fill="none">
					<path
						d="M1.5 1.5v14.2l3.9-3.6 2.6 6 2.6-1.1-2.6-5.9h5.3L1.5 1.5Z"
						fill="#111111"
						stroke="#ffffff"
						stroke-width="1.2"
						stroke-linejoin="round"
					/>
				</svg>
			</span>
		</div>
	</div>
</div>

<style>
	.brand {
		width: 100%;
		max-width: 460px;
		font-family: 'Inter', system-ui, sans-serif;
	}

	.sources {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 6px;
		margin-bottom: 12px;
		font-size: 11px;
	}

	.sources span {
		padding: 4px 9px;
		border-radius: 999px;
		background: #f1f3f0;
		font-weight: 500;
		color: #4b514a;
	}

	.sources .live {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		background: #e8fbe2;
		color: #1d6b33;
	}

	.live i {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: #2fbf5b;
		animation: pulse 1.6s infinite;
	}

	@keyframes pulse {
		0%,
		100% {
			box-shadow: 0 0 0 0 rgba(47, 191, 91, 0.5);
		}
		50% {
			box-shadow: 0 0 0 4px rgba(47, 191, 91, 0);
		}
	}

	.post {
		padding: 14px;
		border: 1px solid #e7eae5;
		border-radius: 12px;
	}

	.post__meta,
	.post__stats {
		margin: 0;
		font-size: 11px;
		color: #7a8079;
	}

	.post__sub {
		font-weight: 600;
		color: #3b403a;
	}

	.post__title {
		margin: 6px 0 0;
		font-size: 14px;
		font-weight: 600;
		line-height: 1.4;
		color: #111111;
	}

	.post__stats {
		margin-top: 8px;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		margin-top: 10px;
	}

	.tag {
		padding: 4px 9px;
		border-radius: 6px;
		background: #eef0ec;
		font-size: 11px;
		font-weight: 600;
		color: #3b403a;
	}

	.tag--intent {
		background: #96f878;
		color: #0c2b15;
	}

	/* Room for the Slack alert to overlap the bottom of the window */
	.spacer {
		height: 40px;
	}

	.alert {
		position: relative;
		z-index: 1;
		margin: -34px 14px 0 34px;
		padding: 14px;
		border-radius: 14px;
		background: #ffffff;
		box-shadow:
			0 24px 50px -16px rgba(0, 0, 0, 0.55),
			0 0 0 1px rgba(12, 43, 21, 0.06);
		color: #1a1d1a;
	}

	.alert__meta {
		display: flex;
		align-items: center;
		gap: 8px;
		margin: 0;
		font-size: 13px;
	}

	.avatar {
		display: grid;
		place-items: center;
		width: 24px;
		height: 24px;
		border-radius: 7px;
		background: #0c2b15;
		font-size: 12px;
		font-weight: 700;
		color: #96f878;
	}

	.time {
		font-size: 11px;
		color: #8a9089;
	}

	.alert__text {
		margin: 8px 0 0;
		font-size: 13px;
		color: #3b403a;
	}

	blockquote {
		margin: 8px 0 0;
		padding: 8px 10px;
		border-left: 3px solid #96f878;
		border-radius: 0 8px 8px 0;
		background: #f5f7f4;
		font-size: 13px;
		line-height: 1.45;
		color: #1a1d1a;
	}

	/* Buttons, the "approved" state and the cursor share one spot */
	.actions {
		position: relative;
		display: grid;
		margin-top: 12px;
	}

	.actions > .btns,
	.actions > .done {
		grid-area: 1 / 1;
	}

	.btns {
		display: flex;
		gap: 8px;
	}

	.btn {
		padding: 7px 14px;
		border: 1px solid #dfe3dd;
		border-radius: 8px;
		font-size: 12px;
		font-weight: 600;
		color: #2c312b;
	}

	.btn--dark {
		border-color: #0c2b15;
		background: #0c2b15;
		color: #ffffff;
	}

	.done {
		justify-self: start;
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 7px 12px;
		border-radius: 8px;
		background: #e8fbe2;
		font-size: 12px;
		font-weight: 600;
		color: #1d6b33;
	}

	.done svg {
		width: 12px;
		height: 12px;
	}

	/* Hovers over the Approve button, then clicks */
	.cursor {
		position: absolute;
		top: 14px;
		left: 46px;
		width: 16px;
		pointer-events: none;
	}

	.cursor svg {
		display: block;
		width: 100%;
		height: auto;
		filter: drop-shadow(0 2px 3px rgba(0, 0, 0, 0.25));
	}

	.cursor:global(.on) svg {
		animation: tap 0.35s ease 0.5s;
	}

	@keyframes tap {
		50% {
			transform: scale(0.82);
		}
	}
</style>
