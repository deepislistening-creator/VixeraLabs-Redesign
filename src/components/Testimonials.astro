---
import { Image } from 'astro:assets';
import janitri from '../assets/founders/JanitriFounder.png';
import mckayn from '../assets/founders/MckaynFounder.png';
import pulzcad from '../assets/founders/PulzCadFounder.png';
import dealroom from '../assets/founders/DealroomFounder.png';
import foxtail from '../assets/founders/FoxtailFounder.png';
import postbridge from '../assets/founders/PostbridgeFounder.png';

// Placeholder content and colors: swap `color` for real images/video once the assets arrive
const featured = [
	{
		title: 'Foxtail Studio runs on what we built',
		name: 'Keith, Founder of Foxtail Studio',
		text: 'Harsh shipped what nobody else could in the timeline we needed. Foxtail Studio runs on what he built.',
		color: '#3c5a4a',
		image: foxtail,
		alt: 'Keith, founder of Foxtail Studio',
	},
	{
		title: 'The design changed how people see us',
		name: 'Founder of Postbridge',
		text: 'The design alone changed how people perceive our brand. We look like a company twice our size.',
		color: '#4a4f63',
		image: postbridge,
		alt: 'Founder of Postbridge',
	},
];

// `color` shows behind the photo while it loads
const stories = [
	{
		company: 'Janitri',
		name: 'Founder',
		title: '$4M raised on Shark Tank',
		quote: "We needed a product ready for Shark Tank — not a prototype we'd have to explain on stage. Harsh shipped the full build in two weeks. We walked on, the product spoke for itself. $4M raised, $15M valuation. That doesn't happen with a half-built MVP.",
		color: '#5b6b78',
		image: janitri,
		alt: 'Founder of Janitri',
	},
	{
		company: 'Mckayn',
		name: 'Founder',
		title: '$4M ARR · 21,000+ customers',
		quote: "Reddit wasn't a marketing channel anyone took seriously — until Harsh built us the tools that turned it into our highest-converting source. 21,000+ customers later, we use what he shipped every day.",
		color: '#6d6152',
		image: mckayn,
		alt: 'Founder of Mckayn',
	},
	{
		company: 'PulzCAD',
		name: 'Arvind, Founder',
		// Non-breaking hyphen keeps "pre-launch" together
		title: 'Acquired pre‑launch',
		quote: "Medical devices demand a level of polish most agencies can't deliver. Harsh built our entire diagnostic stack to spec, CDSCO-ready, before we closed the round. The product was acquisition-ready from day one.",
		color: '#4f6b5c',
		image: pulzcad,
		alt: 'Arvind, founder of PulzCAD',
	},
	{
		company: 'Dealroom Media',
		name: 'Shamus, Founder',
		title: '$2.3M ARR',
		quote: "Harsh doesn't build what you ask for. He builds what you actually need. That's the difference between hiring an engineer and finding a partner. Our entire content engine runs on what he shipped.",
		color: '#5c5670',
		image: dealroom,
		alt: 'Shamus, founder of Dealroom Media',
	},
];

const arrow = 'M1 8h15.5M10 1.5 16.5 8 10 14.5';
---

<section class="testimonials" id="testimonials" aria-labelledby="testimonials-title">
	<div class="head">
		<p class="eyebrow">Testimonial</p>
		<h2 class="title" id="testimonials-title">In their own words. From founders we built for.</h2>
		<p class="subtitle">
			Six founders. One bar: ship the thing their business runs on. Here's what they said after we did.
		</p>
	</div>

	<div class="top">
		<figure class="feature" style={`--fill: ${featured[0].color}`} data-feature>
			{/* One photo per testimonial, stacked; the picked one fades in */}
			{
				featured.map((item, i) => (
					<Image
						src={item.image}
						alt={i === 0 ? item.alt : ''}
						widths={[800, 1200, 1672]}
						sizes="(max-width: 900px) 100vw, 64vw"
						format="webp"
						loading="lazy"
						class:list={['feature__img', { 'is-active': i === 0 }]}
						data-feature-img
					/>
				))
			}
			<button class="feature__play" type="button" aria-label="Play testimonial video">
				<svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
					<path d="M7 5.5v9l7.5-4.5L7 5.5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
				</svg>
			</button>
			<figcaption class="feature__caption">
				<p class="feature__title" data-feature-title>{featured[0].title}</p>
				<p class="feature__name" data-feature-name>{featured[0].name}</p>
			</figcaption>
		</figure>

		<div class="side">
			<div class="info" aria-live="polite">
				<h3 class="info__title" data-info-title>{featured[0].title}</h3>
				<p class="info__text" data-info-text>{featured[0].text}</p>
				<p class="info__name" data-info-name>{featured[0].name}</p>
			</div>

			<ul class="picks">
				{
					featured.map((item, i) => (
						<li>
							<button
								class:list={['pick', { 'is-active': i === 0 }]}
								type="button"
								aria-pressed={i === 0 ? 'true' : 'false'}
								data-title={item.title}
								data-name={item.name}
								data-text={item.text}
								data-color={item.color}
								data-index={i}
								data-alt={item.alt}
							>
								<span class="pick__thumb" style={`--fill: ${item.color}`}>
									<Image
										src={item.image}
										alt=""
										widths={[320, 480, 640]}
										sizes="(max-width: 900px) 42vw, 15vw"
										format="webp"
										loading="lazy"
										class="pick__img"
									/>
								</span>
								<span class="pick__text">{item.title}</span>
							</button>
						</li>
					))
				}
			</ul>
		</div>
	</div>

	<div class="carousel">
		<ul class="track" data-track>
			{
				stories.map((story) => (
					<li class="card" style={`--fill: ${story.color}`} tabindex="0">
						<Image
							src={story.image}
							alt={story.alt}
							widths={[480, 720, 960]}
							sizes="(max-width: 900px) 78vw, 24vw"
							format="webp"
							loading="lazy"
							class="card__img"
						/>
						{/* Glass box: title at rest; grows to fill the card with the full quote on hover */}
						<div class="card__box">
							<p class="card__meta">
								<strong>{story.company}</strong>
								{story.name}
							</p>
							<h3 class="card__title">{story.title}</h3>
							<div class="card__more">
								<p class="card__quote">“{story.quote}”</p>
							</div>
						</div>
					</li>
				))
			}
		</ul>

		<div class="nav">
			<button class="nav__btn" type="button" aria-label="Previous testimonials" data-prev>
				<svg viewBox="0 0 18 16" fill="none" aria-hidden="true" style="transform: scaleX(-1)">
					<path d={arrow} />
				</svg>
			</button>
			<button class="nav__btn" type="button" aria-label="Next testimonials" data-next>
				<svg viewBox="0 0 18 16" fill="none" aria-hidden="true">
					<path d={arrow} />
				</svg>
			</button>
		</div>
	</div>
</section>

<style>
	.testimonials {
		--pad: max(60px, calc(60 * var(--u)));
		background: #ffffff;
		padding: max(100px, calc(100 * var(--u))) var(--pad) 0;
		font-family: 'Inter', system-ui, sans-serif;
		color: #111111;
		overflow: hidden;
	}

	/* Same label as the FAQ section */
	.eyebrow {
		margin: 0;
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: #0c2b15;
	}

	.title {
		max-width: 760px;
		margin: 12px 0 0;
		font-size: max(44px, calc(44 * var(--u)));
		font-weight: 400;
		line-height: 1.15;
		letter-spacing: -0.02em;
	}

	.subtitle {
		margin: 12px 0 0;
		font-size: 16px;
		font-weight: 300;
		line-height: 1.4;
		color: #5e5e5e;
	}

	/* ---------- featured video + side column ---------- */

	.top {
		display: grid;
		grid-template-columns: minmax(0, 2fr) minmax(320px, 1fr);
		gap: max(24px, calc(24 * var(--u)));
		align-items: start;
		margin-top: 40px;
	}

	/* Side column runs the full height of the video: the info card takes the spare room, picks line up with the bottom edge */
	.side {
		align-self: stretch;
		display: flex;
		flex-direction: column;
	}

	/*
	 * Stretches to the row height, so its bottom edge lines up with the last pick even when the side
	 * column's content runs taller than 16:9.4. The ::before spacer keeps that ratio as the minimum height.
	 */
	.feature {
		position: relative;
		align-self: stretch;
		margin: 0;
		overflow: hidden;
		background: var(--fill);
		transition: background-color 0.4s ease;
	}

	.feature::before {
		content: '';
		display: block;
		padding-top: calc(100% * 9.4 / 16);
	}

	.feature__img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0;
		transition: opacity 0.4s ease;
	}

	.feature__img.is-active {
		opacity: 1;
	}

	/* Bottom fade so the white quote stays readable over any photo */
	.feature::after {
		content: '';
		position: absolute;
		inset: 40% 0 0;
		background: linear-gradient(to top, rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0));
		pointer-events: none;
	}

	.feature__play {
		position: absolute;
		top: 50%;
		left: 50%;
		z-index: 1;
		display: grid;
		place-items: center;
		border: 0;
		border-radius: 12px;
		width: 52px;
		height: 52px;
		background: #96f878;
		color: #0c2b15;
		cursor: pointer;
		transform: translate(-50%, -50%);
		transition: transform 0.25s ease;
	}

	.feature__play svg {
		width: 20px;
		height: 20px;
	}

	.feature__play:hover {
		transform: translate(-50%, -50%) scale(1.08);
	}

	.feature__play:focus-visible {
		outline: 2px solid #ffffff;
		outline-offset: 3px;
	}

	.feature__caption {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		z-index: 1;
		padding: max(24px, calc(28 * var(--u)));
		color: #ffffff;
	}

	.feature__title {
		max-width: 720px;
		margin: 0;
		font-size: max(24px, calc(28 * var(--u)));
		font-weight: 400;
		line-height: 1.25;
		letter-spacing: -0.01em;
	}

	.feature__name {
		margin: 8px 0 0;
		font-size: 14px;
		opacity: 0.85;
	}

	/* Details card for whichever video is featured */
	.info {
		flex: 1;
		display: flex;
		flex-direction: column;
		padding: max(24px, calc(28 * var(--u))) max(20px, calc(24 * var(--u)));
		border: 1px solid #ececec;
		background: #ffffff;
		box-shadow: 0 2px 12px rgba(0, 0, 0, 0.05);
	}

	.info__title {
		margin: 0;
		font-size: max(22px, calc(26 * var(--u)));
		font-weight: 400;
		line-height: 1.25;
		letter-spacing: -0.01em;
	}

	.info__text {
		/* Bottom margin keeps a minimum gap above the name when the card is at its shortest */
		margin: 16px 0 24px;
		font-size: 15px;
		font-weight: 300;
		line-height: 1.6;
		color: #313131;
	}

	/* Sits at the foot of the card, whatever height it stretches to */
	.info__name {
		margin: auto 0 0;
		padding-top: 20px;
		border-top: 1px solid #ececec;
		font-size: 14px;
		font-weight: 500;
		color: #5e5e5e;
	}

	.picks {
		display: grid;
		gap: 16px;
		margin: 24px 0 0;
		padding: 0;
		list-style: none;
	}

	.pick {
		display: flex;
		align-items: flex-start;
		gap: 16px;
		width: 100%;
		padding: 0;
		border: 0;
		background: none;
		font: inherit;
		text-align: left;
		cursor: pointer;
	}

	.pick:focus-visible {
		outline: 2px solid #0c2b15;
		outline-offset: 4px;
		border-radius: 8px;
	}

	.pick__thumb {
		flex: none;
		width: 48%;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: var(--fill);
		opacity: 0.6;
		transition: opacity 0.3s ease;
	}

	.pick__img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.pick__text {
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
		font-size: max(17px, calc(20 * var(--u)));
		line-height: 1.4;
		color: #8a8a8a;
		transition: color 0.3s ease;
	}

	.pick.is-active .pick__thumb,
	.pick:hover .pick__thumb {
		opacity: 1;
	}

	.pick.is-active .pick__text,
	.pick:hover .pick__text {
		color: #111111;
	}

	/* ---------- story carousel ---------- */

	.carousel {
		margin-top: max(24px, calc(24 * var(--u)));
		padding-bottom: max(100px, calc(100 * var(--u)));
	}

	/* Bleeds past the right padding so the next card peeks in from the page edge */
	.track {
		--gap: max(20px, calc(20 * var(--u)));
		display: flex;
		gap: var(--gap);
		margin: 0 calc(-1 * var(--pad)) 0 0;
		padding: 0 var(--pad) 0 0;
		list-style: none;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scroll-behavior: smooth;
		scrollbar-width: none;
	}

	.track::-webkit-scrollbar {
		display: none;
	}

	/* Four tall portrait cards with sharp corners, filling the row */
	.card {
		--inset: 20px;
		--ease: cubic-bezier(0.65, 0, 0.35, 1);
		position: relative;
		flex: none;
		/* % is the track's content box, which already excludes the bleed padding */
		width: calc((100% - 3 * var(--gap)) / 4);
		aspect-ratio: 3 / 4;
		overflow: hidden;
		/* Backdrop root, so the glass blur can't pull the white page in at the edges */
		clip-path: inset(0);
		background: var(--fill);
		scroll-snap-align: start;
		outline: none;
	}

	.card:focus-visible {
		box-shadow: inset 0 0 0 2px #0c2b15;
	}

	/* Portraits are anchored near the top so the face stays clear of the box */
	.card__img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 20%;
	}

	/*
	 * Glass box, anchored to the bottom. At rest it fits its content (meta + title); on hover its
	 * min-height grows to the full card, so it rises over the photo and the quote fades in.
	 */
	.card__box {
		position: absolute;
		left: var(--inset);
		right: var(--inset);
		bottom: var(--inset);
		display: flex;
		flex-direction: column;
		min-height: 0;
		padding: 20px;
		/* Same glass as the Principles cards: no border */
		border-radius: 16px;
		background: rgba(255, 255, 255, 0.72);
		-webkit-backdrop-filter: blur(20px);
		backdrop-filter: blur(20px);
		/* Same motion and speed as the Principles cards on the About page */
		transition:
			min-height 0.35s var(--ease),
			left 0.35s var(--ease),
			right 0.35s var(--ease),
			bottom 0.35s var(--ease),
			padding 0.35s var(--ease),
			border-radius 0.35s var(--ease);
	}

	/* Always one line (trimmed with … if tight), so it can't make one box taller than the others */
	.card__meta {
		margin: 0;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		font-family: 'IBM Plex Sans', system-ui, sans-serif;
		font-size: 12px;
		font-weight: 400;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: #2b2b2b;
	}

	.card__meta strong {
		margin-right: 8px;
		font-weight: 600;
		color: #111111;
	}

	.card__title {
		margin: 10px 0 0;
		font-family: 'IBM Plex Sans', system-ui, sans-serif;
		font-size: max(26px, calc(26 * var(--u)));
		font-weight: 300;
		line-height: 1.3;
		letter-spacing: 0.01em;
		color: #111111;
		/* Room for two lines on every card, so all four boxes rest at the same height */
		min-height: calc(2 * 1.3em);
	}

	/* Quote: collapsed at rest, revealed as the box grows */
	.card__more {
		display: grid;
		grid-template-rows: 0fr;
		opacity: 0;
		transition:
			grid-template-rows 0.35s var(--ease),
			opacity 0.2s ease;
	}

	.card__quote {
		min-height: 0;
		overflow: hidden;
		margin: 0;
		padding-top: 16px;
		font-family: 'IBM Plex Sans', system-ui, sans-serif;
		font-size: 16px;
		font-weight: 400;
		line-height: 1.5;
		color: #2b2b2b;
	}

	@media (hover: hover) {
		/* Open: the glass fills the card edge to edge. Padding grows by the inset it loses, so the text doesn't shift sideways */
		.card:hover .card__box,
		.card:focus-visible .card__box {
			left: 0;
			right: 0;
			bottom: 0;
			min-height: 100%;
			padding: calc(20px + var(--inset));
			border-radius: 0;
		}

		/* The two-line reserve only matters at rest; open, the quote sits right under a one-line title */
		.card:hover .card__title,
		.card:focus-visible .card__title {
			min-height: 0;
		}

		.card:hover .card__more,
		.card:focus-visible .card__more {
			grid-template-rows: 1fr;
			opacity: 1;
			transition:
				grid-template-rows 0.35s var(--ease),
				opacity 0.3s ease 0.15s;
		}
	}

	/* Touch screens have no hover, so the quote is always shown */
	@media (hover: none) {
		.card__title {
			min-height: 0;
		}

		.card__more {
			grid-template-rows: 1fr;
			opacity: 1;
		}
	}

	.nav {
		display: flex;
		justify-content: flex-end;
		gap: 12px;
		margin-top: 24px;
	}

	.nav[hidden] {
		display: none;
	}

	.nav__btn {
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		border: 1px solid #e4e4e4;
		border-radius: 50%;
		background: #ffffff;
		color: #111111;
		cursor: pointer;
		transition:
			border-color 0.25s ease,
			color 0.25s ease,
			opacity 0.25s ease;
	}

	.nav__btn svg {
		width: 16px;
		stroke: currentColor;
		stroke-width: 1.6;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.nav__btn:hover:not(:disabled) {
		border-color: #111111;
	}

	.nav__btn:disabled {
		color: #b5b5b5;
		cursor: default;
	}

	.nav__btn:focus-visible {
		outline: 2px solid #0c2b15;
		outline-offset: 2px;
	}

	/* ---------- responsive + motion ---------- */

	@media (max-width: 900px) {
		.testimonials {
			--pad: 16px;
			padding-top: 72px;
		}

		.top {
			grid-template-columns: 1fr;
			gap: 32px;
		}

		.title {
			font-size: clamp(34px, 9vw, 44px);
		}

		.feature::before {
			padding-top: 125%; /* 4:5 */
		}

		.feature__title {
			font-size: 20px;
		}

		.pick__thumb {
			width: 42%;
		}

		.pick__text {
			font-size: 16px;
		}

		.carousel {
			padding-bottom: 72px;
		}

		.card {
			--inset: 12px;
			width: 78%;
		}

		.card__box {
			padding: 16px;
		}

		.card__title {
			font-size: 22px;
		}

		.card__quote {
			font-size: 14px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.track {
			scroll-behavior: auto;
		}

		.feature,
		.feature__img,
		.feature__play,
		.pick__thumb,
		.pick__text,
		.card__box,
		.card__more {
			transition: none !important;
		}
	}
</style>

<script>
	document.querySelectorAll<HTMLElement>('.testimonials').forEach((section) => {
		// Side picks swap the featured testimonial
		const feature = section.querySelector<HTMLElement>('[data-feature]');
		const fields = {
			featureTitle: section.querySelector<HTMLElement>('[data-feature-title]'),
			featureName: section.querySelector<HTMLElement>('[data-feature-name]'),
			infoTitle: section.querySelector<HTMLElement>('[data-info-title]'),
			infoText: section.querySelector<HTMLElement>('[data-info-text]'),
			infoName: section.querySelector<HTMLElement>('[data-info-name]'),
		};
		const picks = section.querySelectorAll<HTMLButtonElement>('.pick');
		const images = section.querySelectorAll<HTMLImageElement>('[data-feature-img]');

		picks.forEach((pick) => {
			pick.addEventListener('click', () => {
				const { title = '', name = '', text = '', color = '', alt = '' } = pick.dataset;
				const index = Number(pick.dataset.index);
				// Only the visible photo carries alt text
				images.forEach((img, i) => {
					img.classList.toggle('is-active', i === index);
					img.alt = i === index ? alt : '';
				});
				picks.forEach((other) => {
					other.classList.toggle('is-active', other === pick);
					other.setAttribute('aria-pressed', String(other === pick));
				});
				feature?.style.setProperty('--fill', color);
				if (fields.featureTitle) fields.featureTitle.textContent = title;
				if (fields.featureName) fields.featureName.textContent = name;
				if (fields.infoTitle) fields.infoTitle.textContent = title;
				if (fields.infoText) fields.infoText.textContent = text;
				if (fields.infoName) fields.infoName.textContent = name;
			});
		});

		// Arrows scroll the track one card at a time and disable at either end
		const track = section.querySelector<HTMLElement>('[data-track]');
		const prev = section.querySelector<HTMLButtonElement>('[data-prev]');
		const next = section.querySelector<HTMLButtonElement>('[data-next]');
		if (!track || !prev || !next) return;

		const step = () => {
			const card = track.querySelector<HTMLElement>('.card');
			return card ? card.offsetWidth + parseFloat(getComputedStyle(track).columnGap || '0') : 0;
		};

		const nav = prev.parentElement;

		const update = () => {
			prev.disabled = track.scrollLeft <= 1;
			next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 1;
			// All four cards fit on desktop, so the arrows only show when there's something to scroll to
			if (nav) nav.hidden = prev.disabled && next.disabled;
		};

		prev.addEventListener('click', () => track.scrollBy({ left: -step() }));
		next.addEventListener('click', () => track.scrollBy({ left: step() }));
		track.addEventListener('scroll', update, { passive: true });
		window.addEventListener('resize', update);
		update();
	});
</script>
