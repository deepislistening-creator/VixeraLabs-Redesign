---
import { Image } from 'astro:assets';
import ArrowButton from './ArrowButton.astro';
import bookACall from '../assets/bookAcall.png';

const faqs = [
	{
		q: 'What is AI automation?',
		a: 'AI automation uses AI models and agents to run repetitive business work end to end: reading emails and documents, updating systems and making routine decisions. Unlike rule-based tools, it handles messy inputs. Vixera Labs builds it around your existing SOPs.',
	},
	{
		q: 'What business processes can be automated with AI?',
		a: 'Any process your team repeats step by step: lead intake and routing, CRM updates, document checks, approvals, follow-ups and reporting. Vixera Labs has automated CRM operations for a $3B healthcare software company and SME credit checks in Southeast Asia.',
	},
	{
		q: 'How long does AI automation take to implement?',
		a: 'Most AI automation projects at Vixera Labs go live in 2–6 weeks; enterprise integrations take 8–12. Mckayn’s operations went live in about two weeks. You get a fixed go-live date before any work starts.',
	},
	{
		q: 'How much does AI automation cost?',
		a: 'AI automation at Vixera Labs is fixed-price, starting from [$X]. The final price depends on the workflows and tools involved, and you get the exact quote after a free 30-minute audit, before any work starts.',
	},
	{
		q: 'How is Vixera Labs different from Zapier or n8n?',
		a: 'Zapier and n8n connect apps with fixed rules, which suits simple triggers. Vixera Labs builds custom AI systems with LangChain and OpenAI that read documents, make routine decisions and run whole processes, like Mckayn’s custom CRM.',
	},
	{
		q: 'Is our data safe with AI automation?',
		a: 'Yes. Vixera Labs gives each AI system access only to the data a workflow needs, with role-based access controls and a security review on enterprise builds. You own all the code, data and accounts.',
	},
];
---

<section class="faq" id="faq" aria-labelledby="faq-title">
	<div class="head">
		<p class="eyebrow">FAQ</p>
		<h2 class="title" id="faq-title">Questions about AI automation</h2>
		<p class="subtitle">
			What business owners and ops teams ask Vixera Labs before handing work to AI.
		</p>
	</div>

	<div class="body">
		<ul class="list">
			{
				faqs.map((item, i) => (
					<li class:list={['item', { 'is-open': i === 0 }]}>
						<h3 class="question">
							<button
								class="trigger"
								type="button"
								id={`faq-q-${i}`}
								aria-expanded={i === 0 ? 'true' : 'false'}
								aria-controls={`faq-a-${i}`}
							>
								<svg class="icon" viewBox="0 0 20 20" fill="none" aria-hidden="true">
									<path class="icon__h" d="M2 10h16" />
									<path class="icon__v" d="M10 2v16" />
								</svg>
								<span>{item.q}</span>
							</button>
						</h3>
						<div class="answer" id={`faq-a-${i}`} role="region" aria-labelledby={`faq-q-${i}`}>
							<div class="answer__inner">
								<p>{item.a}</p>
							</div>
						</div>
					</li>
				))
			}
		</ul>

		<aside class="panel" aria-labelledby="faq-cta-title">
			<Image
				src={bookACall}
				alt=""
				widths={[1080, 1600, 2160, 2560, 3200]}
				sizes="(max-width: 900px) 225vw, 1070px"
				format="webp"
				loading="lazy"
				class="panel__img"
			/>

			<span class="panel__chip">
				<span class="panel__dot" />
				Free · 30 min
			</span>

			<div class="panel__box">
				<h3 class="panel__title" id="faq-cta-title">Still have questions?</h3>
				<p class="panel__text">
					Book a free 30-minute automation audit. We’ll map your workflows, show you what to automate first and give
					you a fixed quote.
				</p>
				<ArrowButton href="#contact" label="Get a Free Audit" />
			</div>
		</aside>
	</div>
</section>

<style>
	.faq {
		--pad: max(60px, calc(60 * var(--u)));
		background: #ffffff;
		padding: max(100px, calc(100 * var(--u))) var(--pad);
		font-family: 'Inter', system-ui, sans-serif;
		color: #111111;
	}

	/* ---------- heading ---------- */

	.eyebrow {
		margin: 0;
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: #0c2b15;
	}

	.title {
		margin: 12px 0 0;
		font-size: max(44px, calc(44 * var(--u)));
		font-weight: 400;
		line-height: 1.15;
		letter-spacing: -0.02em;
	}

	.subtitle {
		margin: 12px 0 0;
		font-size: 16px;
		font-weight: 300;
		line-height: 1.4;
		color: #5e5e5e;
	}

	/* ---------- list + panel ---------- */

	.body {
		display: grid;
		/* List takes the free space; the panel caps at its design width so no dead gap opens up */
		grid-template-columns: minmax(0, 1fr) minmax(360px, 593px);
		gap: max(48px, calc(64 * var(--u)));
		align-items: start;
		margin-top: 40px;
	}

	.list {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.item {
		border-top: 1px solid #e4e4e4;
	}

	.question {
		margin: 0;
	}

	.trigger {
		display: flex;
		align-items: center;
		gap: 16px;
		width: 100%;
		padding: 26px 0;
		border: 0;
		background: none;
		font: inherit;
		font-size: max(22px, calc(22 * var(--u)));
		font-weight: 400;
		line-height: 1.3;
		color: inherit;
		text-align: left;
		cursor: pointer;
	}

	.item.is-open .trigger {
		padding-bottom: 14px;
	}

	.trigger:focus-visible {
		outline: 2px solid #0c2b15;
		outline-offset: 4px;
	}

	/* Plus -> minus: the icon spins a half turn while the vertical bar collapses into the centre */
	.icon {
		flex: none;
		width: 20px;
		height: 20px;
		stroke: currentColor;
		stroke-width: 1.5;
		stroke-linecap: round;
		transition: transform 0.4s cubic-bezier(0.65, 0, 0.35, 1);
	}

	.icon__v {
		transform-box: fill-box;
		transform-origin: center;
		transition: transform 0.4s cubic-bezier(0.65, 0, 0.35, 1);
	}

	.item.is-open .icon {
		transform: rotate(180deg);
	}

	.item.is-open .icon__v {
		transform: scaleY(0);
	}

	/* Height animation via grid rows, so no JS measuring is needed */
	.answer {
		display: grid;
		grid-template-rows: 0fr;
		transition: grid-template-rows 0.4s cubic-bezier(0.65, 0, 0.35, 1);
	}

	.item.is-open .answer {
		grid-template-rows: 1fr;
	}

	.answer__inner {
		overflow: hidden;
	}

	.answer p {
		max-width: 640px;
		margin: 0;
		padding: 0 0 22px 40px;
		font-size: 16px;
		line-height: 1.7;
		color: #5e5e5e;
	}

	.panel {
		position: relative;
		aspect-ratio: 593 / 600;
		overflow: hidden;
		border-radius: 20px;
		/* Makes the panel the backdrop root, so the glass blur can't pull the white page in at the edges */
		clip-path: inset(0 round 20px);
		background: #0c2b15;
	}

	/*
	 * The 16:9 photo is cropped to fill a near-square panel, so it renders wider than the panel:
	 * 600px tall -> ~1070px wide on desktop, ~2.2x the viewport on phones (4:5 panel). `sizes`
	 * above must match that rendered width or the browser picks a file that's too small.
	 */
	.panel__img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 68% center;
	}

	/* Glass chip + box: same treatment as the Companies stat and info panels */
	.panel__chip {
		position: absolute;
		top: 20px;
		left: 20px;
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 8px 14px;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.72);
		-webkit-backdrop-filter: blur(20px);
		backdrop-filter: blur(20px);
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: #0c2b15;
	}

	.panel__dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: #3ddc6b;
		animation: faq-pulse 2s ease-out infinite;
	}

	.panel__box {
		position: absolute;
		left: 20px;
		right: 20px;
		bottom: 20px;
		padding: 24px;
		border: 1px solid rgba(255, 255, 255, 0.7);
		border-radius: 20px;
		/* Opaque enough that hard edges in the photo (desk vs. shirt) don't read through as lines */
		background: rgba(255, 255, 255, 0.86);
		-webkit-backdrop-filter: blur(43px) saturate(1.2);
		backdrop-filter: blur(43px) saturate(1.2);
		color: #111111;
	}

	.panel__title {
		margin: 0;
		font-size: 24px;
		font-weight: 400;
		line-height: 1.2;
		letter-spacing: -0.01em;
	}

	.panel__text {
		max-width: 400px;
		margin: 8px 0 20px;
		font-size: 15px;
		font-weight: 300;
		line-height: 1.5;
		color: #313131;
	}

	@keyframes faq-pulse {
		0% {
			box-shadow: 0 0 0 0 rgba(61, 220, 107, 0.6);
		}
		70%,
		100% {
			box-shadow: 0 0 0 7px rgba(61, 220, 107, 0);
		}
	}

	/* ---------- responsive + motion ---------- */

	@media (max-width: 900px) {
		.faq {
			--pad: 16px;
			padding-top: 72px;
			padding-bottom: 72px;
		}

		.title {
			font-size: clamp(34px, 9vw, 44px);
		}

		.body {
			grid-template-columns: 1fr;
			gap: 40px;
		}

		.trigger {
			padding: 20px 0;
			font-size: 18px;
		}

		.answer p {
			font-size: 15px;
		}

		/* Taller than the photo's ratio so the glass box never covers the whole image on phones */
		.panel {
			aspect-ratio: 4 / 5;
			max-height: 640px;
		}

		.panel__box {
			left: 12px;
			right: 12px;
			bottom: 12px;
			padding: 20px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.answer,
		.icon,
		.icon__v {
			transition: none;
		}

		.panel__dot {
			animation: none;
		}
	}
</style>

<script>
	// One answer open at a time; clicking the open one closes it
	document.querySelectorAll<HTMLElement>('.faq').forEach((faq) => {
		const items = faq.querySelectorAll<HTMLElement>('.item');

		items.forEach((item) => {
			const trigger = item.querySelector<HTMLButtonElement>('.trigger');

			trigger?.addEventListener('click', () => {
				const willOpen = !item.classList.contains('is-open');

				items.forEach((other) => {
					other.classList.remove('is-open');
					other.querySelector('.trigger')?.setAttribute('aria-expanded', 'false');
				});

				if (willOpen) {
					item.classList.add('is-open');
					trigger.setAttribute('aria-expanded', 'true');
				}
			});
		});
	});
</script>
