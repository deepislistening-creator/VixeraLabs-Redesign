---
import ArrowButton from './ArrowButton.astro';

interface Props {
	// false renders just the intro, e.g. as a page lead-in
	showStats?: boolean;
	// Adds the "updated" note and CTA row under the stats
	showActions?: boolean;
}

const { showStats = true, showActions = false } = Astro.props;

const stats = [
	{
		prefix: '$',
		value: 40,
		suffix: 'M+',
		label: 'Raised by companies we’ve built for',
		note: 'Including a $4M Shark Tank deal for Janitri',
	},
	{
		prefix: '$',
		value: 182,
		suffix: 'M+',
		label: 'Combined client valuation',
		note: 'Across healthcare, lending, SaaS and services',
	},
	{ prefix: '', value: 5, suffix: '', label: 'Client companies acquired', note: 'Including PulzCAD, before launch' },
	{ prefix: '', value: 44, suffix: '+', label: 'Products & AI systems shipped', note: 'Building software since 2015' },
];
---

<section class:list={['impact', { 'impact--intro-only': !showStats }]} id="impact" aria-labelledby="impact-intro">
	<p class="intro" id="impact-intro">
		{/* Pages can pass their own intro; wrap the lead-in in <strong> for the dark green emphasis */}
		<slot>
			<strong>Built for companies where execution matters.</strong> We help ambitious teams turn complex operations
			into reliable AI systems built to perform in the real world.
		</slot>
	</p>

	{showStats && (
	<ul class="stats">
		{
			stats.map((stat) => (
				<li class="stat">
					<span class="stat__value">
						<span class="sr-only">{`${stat.prefix}${stat.value}${stat.suffix}`}</span>
						{/* Invisible final value reserves the width so nothing shifts while counting */}
						<span class="stat__ghost" aria-hidden="true">{`${stat.prefix}${stat.value}${stat.suffix}`}</span>
						<span
							class="stat__count"
							aria-hidden="true"
							data-prefix={stat.prefix}
							data-value={stat.value}
							data-suffix={stat.suffix}
						>{`${stat.prefix}${stat.value}${stat.suffix}`}</span>
					</span>
					<span class="stat__text">
						<span class="stat__label">{stat.label}</span>
						<span class="stat__note">{stat.note}</span>
					</span>
				</li>
			))
		}
	</ul>
	)}

	{showStats && showActions && (
	<div class="actions">
		<p class="actions__meta">
			<span class="actions__dot" aria-hidden="true" />
			Updated October 2026 · Clients in the US, the Middle East and Southeast Asia
		</p>
		<div class="actions__ctas">
			<ArrowButton href="#service" label="See what we automate" />
			<ArrowButton href="/work" label="See client results" class="arrow-btn--secondary" />
		</div>
	</div>
	)}
</section>

<style>
	.impact {
		background: #ffffff;
		padding: max(115px, calc(115 * var(--u))) max(60px, calc(60 * var(--u))) max(150px, calc(150 * var(--u)));
	}

	/* Without the stats, the bottom space matches the top */
	.impact--intro-only {
		padding-bottom: max(115px, calc(115 * var(--u)));
	}

	.intro {
		max-width: max(996px, calc(996 * var(--u)));
		margin: 0;
		font-family: 'Inter', system-ui, sans-serif;
		font-size: max(26px, calc(26 * var(--u)));
		font-weight: 300;
		line-height: 1.3;
		color: #5e5e5e;
	}

	.intro strong {
		font-weight: 400;
		color: #0c2b15;
	}

	.stats {
		display: flex;
		justify-content: space-between;
		gap: 32px;
		margin: max(72px, calc(72 * var(--u))) 0 0;
		padding: 0;
		list-style: none;
	}

	.stat {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: max(24px, calc(24 * var(--u)));
		text-align: center;
	}

	.stat__value {
		font-family: 'IBM Plex Sans', system-ui, sans-serif;
		font-size: max(86px, calc(86 * var(--u)));
		font-weight: 300;
		line-height: 1;
		letter-spacing: -0.03em;
		color: #0a0a0a;
		display: grid;
		font-variant-numeric: tabular-nums;
	}

	.stat__ghost,
	.stat__count {
		grid-area: 1 / 1;
		justify-self: center;
	}

	.stat__ghost {
		visibility: hidden;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	.stat__label {
		font-family: 'Inter', system-ui, sans-serif;
		font-size: max(20px, calc(20 * var(--u)));
		font-weight: 300;
		line-height: 1.3;
		color: #5e5e5e;
	}

	.stat__text {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.stat__note {
		font-family: 'Inter', system-ui, sans-serif;
		font-size: max(15px, calc(15 * var(--u)));
		font-weight: 300;
		line-height: 1.4;
		color: #8a8a8a;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		margin-top: max(72px, calc(72 * var(--u)));
		padding-top: max(28px, calc(28 * var(--u)));
		border-top: 1px solid #e8e8e8;
	}

	.actions__meta {
		display: flex;
		align-items: center;
		gap: 10px;
		margin: 0;
		font-family: 'Inter', system-ui, sans-serif;
		font-size: 14px;
		font-weight: 400;
		color: #5e5e5e;
	}

	.actions__dot {
		width: 7px;
		height: 7px;
		flex: none;
		border-radius: 50%;
		background: #3ddc6b;
	}

	.actions__ctas {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
	}

	.actions :global(.arrow-btn--secondary) {
		background: #efebe5;
	}

	.actions :global(.arrow-btn--secondary:hover) {
		background: #e6e1d9;
	}

	@media (max-width: 1100px) {
		.stats {
			display: grid;
			grid-template-columns: repeat(2, 1fr);
			row-gap: 56px;
		}
	}

	@media (max-width: 640px) {
		.impact {
			padding: 72px 16px 88px;
		}

		.impact--intro-only {
			padding-bottom: 72px;
		}

		.intro {
			font-size: 20px;
		}

		.stats {
			margin-top: 48px;
			row-gap: 40px;
			column-gap: 16px;
		}

		.stat {
			gap: 10px;
		}

		.stat__value {
			font-size: clamp(40px, 12vw, 86px);
		}

		.stat__label {
			font-size: 15px;
		}

		.stat__note {
			font-size: 13px;
		}
	}
</style>

<script>
	const DURATION = 2000;
	const STAGGER = 150;

	// Fast start, gentle landing
	const easeOutExpo = (t: number) => (t === 1 ? 1 : 1 - Math.pow(2, -10 * t));

	const counters = document.querySelectorAll<HTMLElement>('.stat__count');
	const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	function render(el: HTMLElement, value: number) {
		el.textContent = `${el.dataset.prefix ?? ''}${Math.round(value)}${el.dataset.suffix ?? ''}`;
	}

	function countUp(el: HTMLElement, delay: number) {
		const target = Number(el.dataset.value);
		let start = 0;

		const step = (now: number) => {
			if (!start) start = now + delay;
			const t = Math.min(Math.max((now - start) / DURATION, 0), 1);
			render(el, target * easeOutExpo(t));
			if (t < 1) requestAnimationFrame(step);
		};
		requestAnimationFrame(step);
	}

	if (counters.length && !prefersReducedMotion) {
		counters.forEach((el) => render(el, 0));

		const observer = new IntersectionObserver(
			(entries) => {
				if (!entries.some((entry) => entry.isIntersecting)) return;
				counters.forEach((el, i) => countUp(el, i * STAGGER));
				observer.disconnect();
			},
			{ threshold: 0.4 },
		);
		observer.observe(document.querySelector('.stats')!);
	}
</script>
